TIMOB-4610,12,"""iOS: app crashes when processing xml""","""""""App crashes when processing xml, usually at about 3 loops in.  This code crashes when you run it with 1.7.1 and works with 1.6.1. The customer has written the code this way so that they can have a delay between loops. If you remove the 'setTimeout' or 'getElementsByTagName' it will <USER>the whole file without issues. No error in the console when it crashes.    I have attached an xml file that you can use for testing if the one in the url doesn't exist.    Step 1: run the code below  Step 2: click the 'test' button  Step 3: in the console you will see about 3 loops output  Step 4: notice the app crash    {code:title=""""""""app.js""""""""}  var win = Titanium.UI.createWindow();  win.open();    var ta = Ti.UI.createButton({   top: 50,   width: 200,   height: 30,   scrollable:false,   title: """"""""test""""""""  });  win.add(ta);  ta.addEventListener('click', function(e) {   var xmlPlacemarks;   var ptr = 0;     function getNextCoordinate() {    if ( ptr<xmlPlacemarks.length ) {     var xmlPlacemark = xmlPlacemarks.item(ptr);     Ti.API.info(xmlPlacemark);     if ( xmlPlacemark ) {      var xmlCoordinates = xmlPlacemark.getElementsByTagName(""""""""TimeStamp"""""""");      Ti.API.info(""""""""Element Number: """""""" + ptr);     }     ptr++;     Ti.API.info(ptr);     setTimeout( getNextCoordinate, 1000);     // getNextCoordinate();    }   }     var xhr = Ti.Network.createHTTPClient();   xhr.open(""""""""GET"""""""", """"""""http://code.google.com/intl/nl-NL/apis/kml/documentation/TimeStamp_example.kml"""""""");   // xhr.open(""""""""GET"""""""", """"""""http://localhost/~<USER>test/TimeStamp_example2.kml"""""""");   xhr.onload = function() {    xmlPlacemarks = this.responseXML.getElementsByTagName(""""""""Placemark"""""""");    Ti.API.info(""""""""Simulator found """""""" + xmlPlacemarks.length + """""""" placemarks"""""""");    getNextCoordinate();   };   xhr.send();  });  {code}    h3. Associated Helpdesk Ticket  http://appc.me/c/APP-495393""""""",Bug,"Title: iOS: app crashes when processing xml
Description: """"App crashes when processing xml, usually at about 3 loops in. This code crashes when you run it with 1.7.1 and works with 1.6.1. The customer has written the code this way so that they can have a delay between loops. If you remove the 'setTimeout' or 'getElementsByTagName' it will <USER>the whole file without issues. No error in the console when it crashes. I have attached an xml file that you can use for testing if the one in the url doesn't exist. Step 1: run the code below Step 2: click the 'test' button Step 3: in the console you will see about 3 loops output Step 4: notice the app crash {code:title=""""""""app.js""""""""} var win = Titanium.UI.createWindow(); win.open(); var ta = Ti.UI.createButton({ top: 50, width: 200, height: 30, scrollable:false, title: """"""""test"""""""" }); win.add(ta); ta.addEventListener('click', function(e) { var xmlPlacemarks; var ptr = 0; function getNextCoordinate() { if ( ptr<xmlPlacemarks.length ) { var xmlPlacemark = xmlPlacemarks.item(ptr); Ti.API.info(xmlPlacemark); if ( xmlPlacemark ) { var xmlCoordinates = xmlPlacemark.getElementsByTagName(""""""""TimeStamp""""""""); Ti.API.info(""""""""Element Number: """""""" + ptr); } ptr++; Ti.API.info(ptr); setTimeout( getNextCoordinate, 1000); // getNextCoordinate(); } } var xhr = Ti.Network.createHTTPClient(); xhr.open(""""""""GET"""""""", """"""""http://code.google.com/intl/nl-NL/apis/kml/documentation/TimeStamp_example.kml""""""""); // xhr.open(""""""""GET"""""""", """"""""http://localhost/~<USER>test/TimeStamp_example2.kml""""""""); xhr.onload = function() { xmlPlacemarks = this.responseXML.getElementsByTagName(""""""""Placemark""""""""); Ti.API.info(""""""""Simulator found """""""" + xmlPlacemarks.length + """""""" placemarks""""""""); getNextCoordinate(); }; xhr.send(); }); {code} h3. Associated Helpdesk Ticket http://appc.me/c/APP-495393""""",title+description
TIMOB-4607,12,"""Android: Activity Crash Debugger""","""""""h2.Problem    Activity crash the debugger in Ti Studio when attempting to Start Debug Server      h3.Reproduction    Drop the following in an app.js, framework.js, page1.js, page2.js, and tiapp.xml and after Run Debug, the debugger will crash automatically.    {code:title=app.js|borderStyle=solid}  var myt={};  Ti.include('page1.js','page2.js','framework.js');  var winConfig = {    backgroundColor:'#fff',    navBarHidden:true,    fullscreen:false  };  var currentPos=0;  var currentPos=0;  var wPage0 = null;  var wPage1=null;    myt.handlePage0=function(){   if(wPage0!==null){    wPage0.close();    Ti.API.info('Page0 closing');   }      winConfig.backgroundColor='red';   wPage0=myt.calendarWin(winConfig);   wPage0.open();   var activity =Ti.Android.currentActivity;     activity.onCreateOptionsMenu = function(e){     var menu = e.menu;        var mTest1 = menu.add({title:'Test 1' });        mTest1.addEventListener(""""""""click"""""""", function(e) {         myt.handlePage1();        });    };   };    myt.handlePage1=function(){   if(wPage1!==null){    wPage1.close();    Ti.API.info('Page1 closing');   }      winConfig.backgroundColor='yellow';   wPage1=myt.calendarWin(winConfig);   wPage1.open();    var activity =Ti.Android.currentActivity;   activity.onCreateOptionsMenu = function(e){     var menu = e.menu;        var mTest1 = menu.add({title:'Test 0' });        mTest1.addEventListener(""""""""click"""""""", function(e) {         myt.handlePage0();        });    };    };    myt.handlePage0();  {code}     {code:title=framework.js|borderStyle=solid}  if (typeof(devkit) === 'undefined'){   devkit = {};   }  devkit.makeWindow=function(a){   var win = Ti.UI.createWindow(a);   win.orientationModes = [    Ti.UI.PORTRAIT,    Ti.UI.UPSIDE_PORTRAIT   ];   return win;   };  {code}    {code:title=page1.js|borderStyle=solid}  myt.calendarWin=function(winConfig){   var win = devkit.makeWindow(winConfig);   return win;  };  {code}    {code:title=page2.js|borderStyle=solid}  myt.settingsWin=function(winConfig){   var win = devkit.makeWindow(winConfig);    return win;  };  {code}      h3.Log When Debugger (Crash)    The following is logged when debugging (trace level):          h3. Log When Running (Normal Run, No Crash)    The following is logged when you simply run the app in the emulator, without the debugger (trace level).          h3. Associated Helpdesk Ticket    http://appc.me/c/APP-916814""""""",Bug,"Title: Android: Activity Crash Debugger
Description: """"h2.Problem Activity crash the debugger in Ti Studio when attempting to Start Debug Server h3.Reproduction Drop the following in an app.js, framework.js, page1.js, page2.js, and tiapp.xml and after Run Debug, the debugger will crash automatically. {code:title=app.js|borderStyle=solid} var myt={}; Ti.include('page1.js','page2.js','framework.js'); var winConfig = { backgroundColor:'#fff', navBarHidden:true, fullscreen:false }; var currentPos=0; var currentPos=0; var wPage0 = null; var wPage1=null; myt.handlePage0=function(){ if(wPage0!==null){ wPage0.close(); Ti.API.info('Page0 closing'); } winConfig.backgroundColor='red'; wPage0=myt.calendarWin(winConfig); wPage0.open(); var activity =Ti.Android.currentActivity; activity.onCreateOptionsMenu = function(e){ var menu = e.menu; var mTest1 = menu.add({title:'Test 1' }); mTest1.addEventListener(""""""""click"""""""", function(e) { myt.handlePage1(); }); }; }; myt.handlePage1=function(){ if(wPage1!==null){ wPage1.close(); Ti.API.info('Page1 closing'); } winConfig.backgroundColor='yellow'; wPage1=myt.calendarWin(winConfig); wPage1.open(); var activity =Ti.Android.currentActivity; activity.onCreateOptionsMenu = function(e){ var menu = e.menu; var mTest1 = menu.add({title:'Test 0' }); mTest1.addEventListener(""""""""click"""""""", function(e) { myt.handlePage0(); }); }; }; myt.handlePage0(); {code} {code:title=framework.js|borderStyle=solid} if (typeof(devkit) === 'undefined'){ devkit = {}; } devkit.makeWindow=function(a){ var win = Ti.UI.createWindow(a); win.orientationModes = [ Ti.UI.PORTRAIT, Ti.UI.UPSIDE_PORTRAIT ]; return win; }; {code} {code:title=page1.js|borderStyle=solid} myt.calendarWin=function(winConfig){ var win = devkit.makeWindow(winConfig); return win; }; {code} {code:title=page2.js|borderStyle=solid} myt.settingsWin=function(winConfig){ var win = devkit.makeWindow(winConfig); return win; }; {code} h3.Log When Debugger (Crash) The following is logged when debugging (trace level): h3. Log When Running (Normal Run, No Crash) The following is logged when you simply run the app in the emulator, without the debugger (trace level). h3. Associated Helpdesk Ticket http://appc.me/c/APP-916814""""",title+description
TIMOB-4606,12,"""KitchenSink: Phone>Play Movie>Local: changing orientation during full screen playback causes NavBar to be overlapped by statusBar ""","""""""Description:  While testing KitchenSink, Phone>Play Movie>Local, I was able to get the navbar partially obscured by the status bar. See screen shot for visual.     Steps to reproduce:  1) Build KS with 1.7.2 rcb4d2d0e  2) Install on iPad 2  3) Navigate to Phone>Play Movie>Local  4) Start movie playback  5) Tap the fullscreen button  6) Rotate the device to new orientation  7) Wait for movie completion    Result:  The NavBar is partially obscured by the statusBar    Expected:  Perfectly rendered UI :)    Notes:  ALso Occurs with Same KS built with 1.7.1""""""",Bug,"Title: KitchenSink: Phone>Play Movie>Local: changing orientation during full screen playback causes NavBar to be overlapped by statusBar
Description: """"Description: While testing KitchenSink, Phone>Play Movie>Local, I was able to get the navbar partially obscured by the status bar. See screen shot for visual. Steps to reproduce: 1) Build KS with 1.7.2 rcb4d2d0e 2) Install on iPad 2 3) Navigate to Phone>Play Movie>Local 4) Start movie playback 5) Tap the fullscreen button 6) Rotate the device to new orientation 7) Wait for movie completion Result: The NavBar is partially obscured by the statusBar Expected: Perfectly rendered UI :) Notes: ALso Occurs with Same KS built with 1.7.1""""",title+description
TIMOB-4605,12,"""KitchenSink: Basic Picker 2 row item font sizes can be toggled by manipulating picker""","""""""Description:  While testing KitchenSink, Controls>Picker>Basic picker 2, I noticed that the font point sizes were changing as I manipulated the picker. The text size seems to toggle as you pull the picker to the limit then beyond repeatedly.    Looking at the .js, there are point sizes specified for each picker row item for the test. The bug may be related to this, as no other KS picker has this issue, and none of them specify font size.       Steps to reproduce:  1) Build KS with 1.7.2 rcb4d2d0e  2) Install on iPad 2  3) Navigate to Controls>Picker>Basic picker 2  4) pull picker to the extent (up or down)  5) Try to pull beyond extent  6) Repeat step 5    Result:  Depending on which way you try to go, either Strawberries or Mangos will toggle from large to small.    Expected:  No point size change, unless desired effect is to simulate text on cylinder    Notes:  Also occurs when same KS built with 1.7.1""""""",Bug,"Title: KitchenSink: Basic Picker 2 row item font sizes can be toggled by manipulating picker
Description: """"Description: While testing KitchenSink, Controls>Picker>Basic picker 2, I noticed that the font point sizes were changing as I manipulated the picker. The text size seems to toggle as you pull the picker to the limit then beyond repeatedly. Looking at the .js, there are point sizes specified for each picker row item for the test. The bug may be related to this, as no other KS picker has this issue, and none of them specify font size. Steps to reproduce: 1) Build KS with 1.7.2 rcb4d2d0e 2) Install on iPad 2 3) Navigate to Controls>Picker>Basic picker 2 4) pull picker to the extent (up or down) 5) Try to pull beyond extent 6) Repeat step 5 Result: Depending on which way you try to go, either Strawberries or Mangos will toggle from large to small. Expected: No point size change, unless desired effect is to simulate text on cylinder Notes: Also occurs when same KS built with 1.7.1""""",title+description
TIMOB-4604,12,"""KitchenSink: Base UI>Views>Table Views>Table View (layout 5) has images missing from tableview""","""""""Description:  While testing KitchenSink, Base UI>Views>Table Views>Table View (layout 5), I noticed that two of the images in the table are not rendering. I checked the URLs listed in the .js and they functioned fine from a browser. The two lines are:    'http://t2.gstatic.com/images?q=tbn:-iOGlc8ww3Zx8M:http://www.arukereso.hu/akciostippek/wp-content/uploads/2009/06/apple-iphone.jpg',  'http://t3.gstatic.com/images?q=tbn:T2pHhXb3a80U1M:http://hirkep.wapzona.hu/2008/07/28/apple_touch.jpg'       Steps to reproduce:  1) Build KS with 1.7.2 rcb4d2d0e  2) Install on iPad 2  3) Navigate to Base UI>Views>Table Views>Table View (layout 5)  4) Check the table for missing images    Result:  Two images are missing from the tableview    Expected:  No missing imagesw    Notes:  Also occurs when same KS built with 1.7.1""""""",Bug,"Title: KitchenSink: Base UI>Views>Table Views>Table View (layout 5) has images missing from tableview
Description: """"Description: While testing KitchenSink, Base UI>Views>Table Views>Table View (layout 5), I noticed that two of the images in the table are not rendering. I checked the URLs listed in the .js and they functioned fine from a browser. The two lines are: 'http://t2.gstatic.com/images?q=tbn:-iOGlc8ww3Zx8M:http://www.arukereso.hu/akciostippek/wp-content/uploads/2009/06/apple-iphone.jpg', 'http://t3.gstatic.com/images?q=tbn:T2pHhXb3a80U1M:http://hirkep.wapzona.hu/2008/07/28/apple_touch.jpg' Steps to reproduce: 1) Build KS with 1.7.2 rcb4d2d0e 2) Install on iPad 2 3) Navigate to Base UI>Views>Table Views>Table View (layout 5) 4) Check the table for missing images Result: Two images are missing from the tableview Expected: No missing imagesw Notes: Also occurs when same KS built with 1.7.1""""",title+description
TIMOB-4603,12,"""KitchenSink: iPad 4-finger gesture causes unexpected behavior with orientation and app pause""","""""""Description:  While testing KitchenSink, I noticed that the iPad gesture """"""""4-finger swipe"""""""" was reporting  in the log that the app was pausing and resuming. It also seems to change reported orientation when device is face up.    Jul  6 10:30:04 unknown UIKitApplication:com.<USER>pushtest[0xca96][398] <Notice>: [INFO] app was paused from the foreground  Jul  6 10:30:06 unknown UIKitApplication:com.<USER>pushtest[0xca96][398] <Notice>: [DEBUG] fire app event: resumed  Jul  6 10:30:06 unknown UIKitApplication:com.<USER>pushtest[0xca96][398] <Notice>: [INFO] app has resumed from the background     Steps to reproduce:  1) Build KS with 1.7.2 rcb4d2d0e  2) Install on iPad 2  3) Navigate to Phone > Orientation  4) Check console output  5) Place device face-up on table  6) Perform 4-finger swipe  7) Note the reported orientation and check log output    Result:  Log reports pause from foreground and resume  Orientation may report change    Expected:  No change in orientation reporting, no application pause    Notes:  Also occurs when same KS built with 1.7.1    This may be two root causes.... If so I will break out and report a separate bug.""""""",Bug,"Title: KitchenSink: iPad 4-finger gesture causes unexpected behavior with orientation and app pause
Description: """"Description: While testing KitchenSink, I noticed that the iPad gesture """"""""4-finger swipe"""""""" was reporting in the log that the app was pausing and resuming. It also seems to change reported orientation when device is face up. Jul 6 10:30:04 unknown UIKitApplication:com.<USER>pushtest[0xca96][398] <Notice>: [INFO] app was paused from the foreground Jul 6 10:30:06 unknown UIKitApplication:com.<USER>pushtest[0xca96][398] <Notice>: [DEBUG] fire app event: resumed Jul 6 10:30:06 unknown UIKitApplication:com.<USER>pushtest[0xca96][398] <Notice>: [INFO] app has resumed from the background Steps to reproduce: 1) Build KS with 1.7.2 rcb4d2d0e 2) Install on iPad 2 3) Navigate to Phone > Orientation 4) Check console output 5) Place device face-up on table 6) Perform 4-finger swipe 7) Note the reported orientation and check log output Result: Log reports pause from foreground and resume Orientation may report change Expected: No change in orientation reporting, no application pause Notes: Also occurs when same KS built with 1.7.1 This may be two root causes.... If so I will break out and report a separate bug.""""",title+description
TIMOB-4602,12,"""KitchenSink: Orientation reporting new values for Landscape and Portrait in 1.7.2""","""""""Description:  While testing KitchenSink, I noticed that the Orientation being reported has changed in 1.7.2. In 1.7.1 and earlier, iPad reports one of the following: Face Up, Face Down, Landscape left, landscape right, portrait, upside portrait, and unknown.  In 1.7.2,  Landscape left has become """"""""reverse landscape"""""""" and landscape right has become """"""""Landscape"""""""". Upside portrait is now """"""""reverse portrait""""""""    Steps to reproduce:  1) Build KS  2) Install on iPad 2  3) Navigate to Phone>Orientation  4) Rotate device to all it's orientations  5) Note the reported orientation    Result:  Landscape left and right replaced with """"""""Landscape"""""""" and """"""""reverse landscape"""""""", Upside portrait now """"""""Reverse portrait""""""""    Expected:  No change in orientation reporting""""""",Bug,"Title: KitchenSink: Orientation reporting new values for Landscape and Portrait in 1.7.2
Description: """"Description: While testing KitchenSink, I noticed that the Orientation being reported has changed in 1.7.2. In 1.7.1 and earlier, iPad reports one of the following: Face Up, Face Down, Landscape left, landscape right, portrait, upside portrait, and unknown. In 1.7.2, Landscape left has become """"""""reverse landscape"""""""" and landscape right has become """"""""Landscape"""""""". Upside portrait is now """"""""reverse portrait"""""""" Steps to reproduce: 1) Build KS 2) Install on iPad 2 3) Navigate to Phone>Orientation 4) Rotate device to all it's orientations 5) Note the reported orientation Result: Landscape left and right replaced with """"""""Landscape"""""""" and """"""""reverse landscape"""""""", Upside portrait now """"""""Reverse portrait"""""""" Expected: No change in orientation reporting""""",title+description
TIMOB-4600,12,"""iOS messages not appropriately color-coded by TiStudio""","""""""Partially a debugger issue (we don't send """"""""warn"""""""" correctly). May be more problematic because we probably do not shunt any NSLog messages through the debugger at all.""""""",Bug,"Title: iOS messages not appropriately color-coded by TiStudio
Description: """"Partially a debugger issue (we don't send """"""""warn"""""""" correctly). May be more problematic because we probably do not shunt any NSLog messages through the debugger at all.""""",title+description
TIMOB-4599,12,"""iOS Regression: MapView Region Doesn't Set in 1.7.0+""","""""""h1. Regression  The region of a map view in a tab group is no longer respected, so the initial view of a map view is always fully zoomed out (showing the whole world).    h2. Reproduction  Drop the following in an app.js. If you use 1.7.0 through the latest 1.8.0 builds with the iPhone Simulator, you will see the whole world. But use 1.6.2 and you will see a specific region.  {code:title=app.js}  var win = Ti.UI.createWindow({ backgroundColor: '#fff' });  var map = Ti.Map.createView({      mapType: Ti.Map.STANDARD_TYPE,      regionFit: true,      region: { latitude: 60, longitude: 10.760797, latitudeDelta: 0.035, longitudeDelta: 0.035 }  });  win.add(map);    var tabGroup = Ti.UI.createTabGroup();  tabGroup.addTab(Ti.UI.createTab({      window: win  }));  tabGroup.open();    // WORKAROUND 1: Don't use a tab group (comment lines 9-13)  //win.open();    // WORKAROUND 2: Don't add the map to the window until the open event fires (comment line 7)  //win.addEventListener('open', function() { win.add(map); });  {code}    h2. Workarounds  There are two workarounds documented in the code above. The first is to take out the tab groups; if you use a normal window, this bug doesn't manifest. The second is to wait to add the map to the window until after the window opens.    h3. Associated Helpdesk Ticket  http://appc.me/c/APP-786764""""""",Bug,"Title: iOS Regression: MapView Region Doesn't Set in 1.7.0+
Description: """"h1. Regression The region of a map view in a tab group is no longer respected, so the initial view of a map view is always fully zoomed out (showing the whole world). h2. Reproduction Drop the following in an app.js. If you use 1.7.0 through the latest 1.8.0 builds with the iPhone Simulator, you will see the whole world. But use 1.6.2 and you will see a specific region. {code:title=app.js} var win = Ti.UI.createWindow({ backgroundColor: '#fff' }); var map = Ti.Map.createView({ mapType: Ti.Map.STANDARD_TYPE, regionFit: true, region: { latitude: 60, longitude: 10.760797, latitudeDelta: 0.035, longitudeDelta: 0.035 } }); win.add(map); var tabGroup = Ti.UI.createTabGroup(); tabGroup.addTab(Ti.UI.createTab({ window: win })); tabGroup.open(); // WORKAROUND 1: Don't use a tab group (comment lines 9-13) //win.open(); // WORKAROUND 2: Don't add the map to the window until the open event fires (comment line 7) //win.addEventListener('open', function() { win.add(map); }); {code} h2. Workarounds There are two workarounds documented in the code above. The first is to take out the tab groups; if you use a normal window, this bug doesn't manifest. The second is to wait to add the map to the window until after the window opens. h3. Associated Helpdesk Ticket http://appc.me/c/APP-786764""""",title+description
TIMOB-4598,12,"""Android: Module Build Doesn't Ignore .DS_Store when building documentation""","""""""h1. Problem  The build scripts for Android modules will run any file in the documentation folder through markdown, including .DS_Store and other files that should be ignored. This results in an error being thrown, and the documentation not being generated.    h2. How To Reproduce  1. Create a new module for Android  2. Copy a .DS_Store file in to the documentation directory  3. ant and you will see an error message; the resulting zip will not have documentation in it    h2. Pull Request  https://github.com/<USER>titanium_mobile/pull/188""""""",Bug,"Title: Android: Module Build Doesn't Ignore .DS_Store when building documentation
Description: """"h1. Problem The build scripts for Android modules will run any file in the documentation folder through markdown, including .DS_Store and other files that should be ignored. This results in an error being thrown, and the documentation not being generated. h2. How To Reproduce 1. Create a new module for Android 2. Copy a .DS_Store file in to the documentation directory 3. ant and you will see an error message; the resulting zip will not have documentation in it h2. Pull Request https://github.com/<USER>titanium_mobile/pull/188""""",title+description
TIMOB-4597,12,"""iOS: Tabbed Bar - objects are misplaced on load, redraw to correct locations ""","""""""The tabbed bar is drawn wrongly under SDK 1.7.0 / iOS 4.1, the buttons of a button bar are draw as plain labels on top of each other (see attached """"""""wrong.png"""""""" screenshot). It should be an ordinary button bar in the navigator title bar (see attached """"""""allright.png"""""""").    h3.Reproduction          h3.Associated Helpdesk ticket  http://appc.me/c/APP-474263    h4.Comment  There is a Jira ticket that addressed this issue, it was fixed for release 1.6, tested 4.2.  http://jira.<USER>org/browse/TIMOB-2353  """"""",Bug,"Title: iOS: Tabbed Bar - objects are misplaced on load, redraw to correct locations
Description: """"The tabbed bar is drawn wrongly under SDK 1.7.0 / iOS 4.1, the buttons of a button bar are draw as plain labels on top of each other (see attached """"""""wrong.png"""""""" screenshot). It should be an ordinary button bar in the navigator title bar (see attached """"""""allright.png""""""""). h3.Reproduction h3.Associated Helpdesk ticket http://appc.me/c/APP-474263 h4.Comment There is a Jira ticket that addressed this issue, it was fixed for release 1.6, tested 4.2. http://jira.<USER>org/browse/TIMOB-2353 """"",title+description
TIMOB-4596,12,"""iPad: Resized image of ImageView""","""""""* We want to *re-size* an image to map components to certain coordinates in the _ImageView_.    * Get the *+height+* and *+width+* properties of the _resized_ image.    {code:title=app.js|borderStyle=solid}    var win = Ti.UI.createWindow({   backgroundColor:'blue'  });    var image = Titanium.UI.createImageView({   image:'http://lh5.ggpht.com/-J7Q7cUDEFOU/S_bKEoyMSzI/AAAAAAAAGIw/PZJduitsVa0/largeNewGoogleLogoFinalFlat-a.png',   height: 'auto'  });  image.addEventListener('load', function(){   var img = image.toImage();   alert(""""""""Width: """"""""+ img.width + """""""" / Height: """""""" + img.height);  });    Titanium.Gesture.addEventListener('orientationchange', function(e) {   alert(""""""""Orientation: """""""" + e.orientation);      var img2 = image.toImage();   alert(""""""""Width: """"""""+ img2.width + """""""" / Height: """""""" + img2.height);  });    win.add(image);  win.open();  {code}      - *toBlob() :* gives us the _source_ image's dimensions.     - *toImage() :* gives us the _width_ and _height_ of the image display it.    {quote}  h3. Associated Helpdesk Ticket    http://support.<USER>com/tickets/APP-238573  {quote}""""""",Bug,"Title: iPad: Resized image of ImageView
Description: """"* We want to *re-size* an image to map components to certain coordinates in the _ImageView_. * Get the *+height+* and *+width+* properties of the _resized_ image. {code:title=app.js|borderStyle=solid} var win = Ti.UI.createWindow({ backgroundColor:'blue' }); var image = Titanium.UI.createImageView({ image:'http://lh5.ggpht.com/-J7Q7cUDEFOU/S_bKEoyMSzI/AAAAAAAAGIw/PZJduitsVa0/largeNewGoogleLogoFinalFlat-a.png', height: 'auto' }); image.addEventListener('load', function(){ var img = image.toImage(); alert(""""""""Width: """"""""+ img.width + """""""" / Height: """""""" + img.height); }); Titanium.Gesture.addEventListener('orientationchange', function(e) { alert(""""""""Orientation: """""""" + e.orientation); var img2 = image.toImage(); alert(""""""""Width: """"""""+ img2.width + """""""" / Height: """""""" + img2.height); }); win.add(image); win.open(); {code} - *toBlob() :* gives us the _source_ image's dimensions. - *toImage() :* gives us the _width_ and _height_ of the image display it. {quote} h3. Associated Helpdesk Ticket http://support.<USER>com/tickets/APP-238573 {quote}""""",title+description
TIMOB-4595,12,"""iOS: allow access to the scrollEnabled property for a textArea""","""""""Would like to be able to disable scrolling on a textArea by setting """"""""scrollable = false"""""""".    {code:title=""""""""app.js""""""""}  var win = Titanium.UI.createWindow();  win.open();    var ta = Ti.UI.createTextArea({   top: 50,   width: 200,   height: 30,   scrollable:false,   backgroundColor: """"""""white""""""""  });  win.add(ta);      h3. Associated Helpdesk Ticket  http://appc.me/c/RUT-47599-528    h3. Pull Request  https://github.com/<USER>titanium_mobile/pull/186""""""",New Feature,"Title: iOS: allow access to the scrollEnabled property for a textArea
Description: """"Would like to be able to disable scrolling on a textArea by setting """"""""scrollable = false"""""""". {code:title=""""""""app.js""""""""} var win = Titanium.UI.createWindow(); win.open(); var ta = Ti.UI.createTextArea({ top: 50, width: 200, height: 30, scrollable:false, backgroundColor: """"""""white"""""""" }); win.add(ta); h3. Associated Helpdesk Ticket http://appc.me/c/RUT-47599-528 h3. Pull Request https://github.com/<USER>titanium_mobile/pull/186""""",title+description
TIMOB-4594,12,"""iPhone: Save image as PNG of an ImageView""","""""""h5. We want to save the ImageView's image as .PNG to maintain its transparency.  h5. This image has been gotten via toImage() or toBlob().    {quote}  h3. Associated Helpdesk Ticket    http://support.<USER>com/tickets/APP-788172  {quote}""""""",New Feature,"Title: iPhone: Save image as PNG of an ImageView
