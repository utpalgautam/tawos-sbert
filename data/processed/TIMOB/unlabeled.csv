TIMOB-16136,12,"""iOS: TabGroup doesn't adapt its width to screen's width after orientation change""","""""""TabGroup doesn't adapt its width to screen's width after orientation is changed in window without tabGroup (You can see that issue in attached video).      {code:xml}  <Alloy>   <TabGroup>       <Tab title=""""""""Tab 1"""""""" icon=""""""""tab_icons/0.png"""""""">           <Window id=""""""""win1"""""""" title=""""""""Win 1"""""""">               <Button onClick=""""""""openWindow"""""""">Open new window</Button>              </Window>       </Tab>                     <Tab title=""""""""Tab 2"""""""" icon=""""""""tab_icons/1.png"""""""">           <Window id=""""""""win2"""""""" title=""""""""Win 2""""""""/>       </Tab>              <Tab title=""""""""Tab 1"""""""" icon=""""""""tab_icons/2.png"""""""">           <Window id=""""""""win3"""""""" title=""""""""Win 3""""""""/>       </Tab>      </TabGroup>   </Alloy>  {code}    {code:javascript}  """"""""Window"""""""":{      backgroundColor: """"""""white"""""""",      orientationModes: [Ti.UI.PORTRAIT]  }  {code}    {code:javascript}  $.index.open();    var openWindow = function(){   var win = Ti.UI.createWindow({    backgroundColor: """"""""white"""""""",    orientationModes: [Ti.UI.PORTRAIT, Ti.UI.LANDSCAPE_LEFT, Ti.UI.LANDSCAPE_RIGHT],    tabBarHidden: true   });      $.index.activeTab.open(win);  };  {code}""""""",Bug,"Title: iOS: TabGroup doesn't adapt its width to screen's width after orientation change
Description: """"TabGroup doesn't adapt its width to screen's width after orientation is changed in window without tabGroup (You can see that issue in attached video). {code:xml} <Alloy> <TabGroup> <Tab title=""""""""Tab 1"""""""" icon=""""""""tab_icons/0.png""""""""> <Window id=""""""""win1"""""""" title=""""""""Win 1""""""""> <Button onClick=""""""""openWindow"""""""">Open new window</Button> </Window> </Tab> <Tab title=""""""""Tab 2"""""""" icon=""""""""tab_icons/1.png""""""""> <Window id=""""""""win2"""""""" title=""""""""Win 2""""""""/> </Tab> <Tab title=""""""""Tab 1"""""""" icon=""""""""tab_icons/2.png""""""""> <Window id=""""""""win3"""""""" title=""""""""Win 3""""""""/> </Tab> </TabGroup> </Alloy> {code} {code:javascript} """"""""Window"""""""":{ backgroundColor: """"""""white"""""""", orientationModes: [Ti.UI.PORTRAIT] } {code} {code:javascript} $.index.open(); var openWindow = function(){ var win = Ti.UI.createWindow({ backgroundColor: """"""""white"""""""", orientationModes: [Ti.UI.PORTRAIT, Ti.UI.LANDSCAPE_LEFT, Ti.UI.LANDSCAPE_RIGHT], tabBarHidden: true }); $.index.activeTab.open(win); }; {code}""""",title+description
TIMOB-16135,12,"""Android: Console error for layout cleanup after closing window with model binding""","""""""h3. Steps to Reproduce When you import example project binding_destroy which presents how to unbind models then add to your tiapp.xml: <property name='ti.android.debug' type='bool'>true</property> You'll see in console that there are errors related to unbinding data. [ERROR] :  TiBaseActivity: (main) [2,17032] Layout cleanup.  h3. Actual Result [ERROR] :  TiBaseActivity: (main) [2,17032] Layout cleanup.  h3. Expected Result No error""""""",Bug,"Title: Android: Console error for layout cleanup after closing window with model binding
