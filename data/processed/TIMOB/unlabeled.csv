TIMOB-4333,12,"""Android: videoPlayer does not fire playing event""","""""""Android videoPlayer does not fire a playing event when the currently playing movie changes.    Step 1: run the code below  Step 2: notice that 'playing' never fires    {code:title=""""""""app.js""""""""}  var win = Titanium.UI.createWindow();  var activeMovie = Titanium.Media.createVideoPlayer({      contentURL: 'http://theatercrew.com/sample.mp4',   autoplay: true  });    win.add(activeMovie);  win.open();  activeMovie.play();    activeMovie.addEventListener('playing',function(){      Ti.API.info('activeMovie.addEventListener(\'playing\',function(){');  });  {code}    h3. Tested With   TiSDK 1.7.0.RC1  Android 2.3    h3. Associated Helpdesk Ticket  http://appc.me/c/APP-888114""""""",Bug,"Title: Android: videoPlayer does not fire playing event
Description: """"Android videoPlayer does not fire a playing event when the currently playing movie changes. Step 1: run the code below Step 2: notice that 'playing' never fires {code:title=""""""""app.js""""""""} var win = Titanium.UI.createWindow(); var activeMovie = Titanium.Media.createVideoPlayer({ contentURL: 'http://theatercrew.com/sample.mp4', autoplay: true }); win.add(activeMovie); win.open(); activeMovie.play(); activeMovie.addEventListener('playing',function(){ Ti.API.info('activeMovie.addEventListener(\'playing\',function(){'); }); {code} h3. Tested With TiSDK 1.7.0.RC1 Android 2.3 h3. Associated Helpdesk Ticket http://appc.me/c/APP-888114""""",title+description
TIMOB-4332,12,"""iOS: videoPlayer does not fire load event""","""""""iOS videoPlayer does not fire a load event when the movie play loads.     Step 1: run the code below  Step 2: notice that 'load' never fires    {code:title=""""""""app.js""""""""}  var win = Titanium.UI.createWindow();  var activeMovie = Titanium.Media.createVideoPlayer({      contentURL: 'http://theatercrew.com/sample.mp4',   autoplay: true  });    win.add(activeMovie);  win.open();  activeMovie.play();    activeMovie.addEventListener('load',function(){      Ti.API.info('activeMovie.addEventListener(\'load\',function(){');  });  {code}    h3. Tested With   TiSDK 1.7.0.RC1  iOS 4.3    h3. Associated Helpdesk Ticket  http://appc.me/c/APP-888114""""""",Bug,"Title: iOS: videoPlayer does not fire load event
Description: """"iOS videoPlayer does not fire a load event when the movie play loads. Step 1: run the code below Step 2: notice that 'load' never fires {code:title=""""""""app.js""""""""} var win = Titanium.UI.createWindow(); var activeMovie = Titanium.Media.createVideoPlayer({ contentURL: 'http://theatercrew.com/sample.mp4', autoplay: true }); win.add(activeMovie); win.open(); activeMovie.play(); activeMovie.addEventListener('load',function(){ Ti.API.info('activeMovie.addEventListener(\'load\',function(){'); }); {code} h3. Tested With TiSDK 1.7.0.RC1 iOS 4.3 h3. Associated Helpdesk Ticket http://appc.me/c/APP-888114""""",title+description
TIMOB-4331,12,"""Android: removing a label from an activeMovie/videoPlayer does not work""","""""""You can add a label to a videoPlayer, but removing it does not work. See the example below.     Step 1: Run the code below  Step 2: notice that the red 'Loading...' text does not get removed.  Step 3: if you set visible false on the label, it will disappear.    {code:title=""""""""app.js""""""""}  var win = Titanium.UI.createWindow();  var activeMovie = Titanium.Media.createVideoPlayer({      contentURL: 'http://theatercrew.com/sample.mp4',   autoplay: true  });  loadingLabel = Titanium.UI.createLabel({    text:""""""""Loading..."""""""",    color: """"""""#f00"""""""",    width: """"""""auto"""""""",    height: """"""""auto""""""""  });  activeMovie.add(loadingLabel);  win.open();  activeMovie.play();    activeMovie.addEventListener('load',function(){      Ti.API.info('activeMovie.addEventListener(\'load\',function(){');      // ---- remove does not work on android ------      activeMovie.remove(loadingLabel);      // loadingLabel.visible = false;  });  {code}    h3. Workaround  loadingLabel.visible = false;    h3. Tested With  TiSDK 1.7.0.RC1  Android 2.3    h3. Associated Helpdesk Ticket  http://appc.me/c/APP-888114  """"""",Bug,"Title: Android: removing a label from an activeMovie/videoPlayer does not work
Description: """"You can add a label to a videoPlayer, but removing it does not work. See the example below. Step 1: Run the code below Step 2: notice that the red 'Loading...' text does not get removed. Step 3: if you set visible false on the label, it will disappear. {code:title=""""""""app.js""""""""} var win = Titanium.UI.createWindow(); var activeMovie = Titanium.Media.createVideoPlayer({ contentURL: 'http://theatercrew.com/sample.mp4', autoplay: true }); loadingLabel = Titanium.UI.createLabel({ text:""""""""Loading..."""""""", color: """"""""#f00"""""""", width: """"""""auto"""""""", height: """"""""auto"""""""" }); activeMovie.add(loadingLabel); win.open(); activeMovie.play(); activeMovie.addEventListener('load',function(){ Ti.API.info('activeMovie.addEventListener(\'load\',function(){'); // ---- remove does not work on android ------ activeMovie.remove(loadingLabel); // loadingLabel.visible = false; }); {code} h3. Workaround loadingLabel.visible = false; h3. Tested With TiSDK 1.7.0.RC1 Android 2.3 h3. Associated Helpdesk Ticket http://appc.me/c/APP-888114 """"",title+description
