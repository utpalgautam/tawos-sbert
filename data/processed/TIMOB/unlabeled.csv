TIMOB-27899,12,"""Common: path.parse with a file extension but no directory results in an invalid dir value""","""""""h5.Description    When calling {{path.parse('a.js'}} the {{dir}} value in the returned object is {{dir: 'a.j'}} which is incorrect, the value should be {{dir: ''}}    h5.Steps to reproduce  1. Add {{console.log(path.parse('a.js'));}} to your {{app.js}} and build    h5.Actual  [INFO]  { root: '', dir: 'a.j', base: 'a.js', ext: '.js', name: 'a' }  h5.Expected  [INFO]  { root: '', dir: ''. base: '', ext: '.js', name: 'a' }  """"""",Bug,"Title: Common: path.parse with a file extension but no directory results in an invalid dir value
Description: """"h5.Description When calling {{path.parse('a.js'}} the {{dir}} value in the returned object is {{dir: 'a.j'}} which is incorrect, the value should be {{dir: ''}} h5.Steps to reproduce 1. Add {{console.log(path.parse('a.js'));}} to your {{app.js}} and build h5.Actual [INFO] { root: '', dir: 'a.j', base: 'a.js', ext: '.js', name: 'a' } h5.Expected [INFO] { root: '', dir: ''. base: '', ext: '.js', name: 'a' } """"",title+description
TIMOB-27898,12,"""iOS: Race condition in setTimeout/clearTimeout (regression)""","""""""There seem to be a critical regression regarding intervals in SDK 8 and 9 (so maybe caused between SDK 7 and 8?). See the following vanilla Node.js test case for reference (using a classic throttling mechanism):  {code:js}  let searchTimeout;    function search(value) {   if (searchTimeout) {    console.warn('Abort request');    clearTimeout(searchTimeout);   }     searchTimeout = setTimeout(() => {          console.warn('Start search: ' + value);   }, 500);  }    function sleep(ms) {      return new Promise(resolve => setTimeout(resolve, ms));  }    (async function () {      search('m');      search('me');      search('mep');  }());    Abort request  Abort request  Start search: mep    Abort request  Start search: m  Start search: mep      Notably, iOS does something wrong here. And Android works just fine (like Node.js).""""""",Bug,"Title: iOS: Race condition in setTimeout/clearTimeout (regression)
Description: """"There seem to be a critical regression regarding intervals in SDK 8 and 9 (so maybe caused between SDK 7 and 8?). See the following vanilla Node.js test case for reference (using a classic throttling mechanism): {code:js} let searchTimeout; function search(value) { if (searchTimeout) { console.warn('Abort request'); clearTimeout(searchTimeout); } searchTimeout = setTimeout(() => { console.warn('Start search: ' + value); }, 500); } function sleep(ms) { return new Promise(resolve => setTimeout(resolve, ms)); } (async function () { search('m'); search('me'); search('mep'); }()); Abort request Abort request Start search: mep Abort request Start search: m Start search: mep Notably, iOS does something wrong here. And Android works just fine (like Node.js).""""",title+description
