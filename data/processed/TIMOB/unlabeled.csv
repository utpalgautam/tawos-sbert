TIMOB-3005,12,"""autocapitalization:Titanium.UI.TEXT.AUTOCAPITALIZATION_NONE not working""","""""""{html}<div><p>This does not work - Kitchen Sink - textfield_therest.js</p></div>{html}""""""",Bug,"Title: autocapitalization:Titanium.UI.TEXT.AUTOCAPITALIZATION_NONE not working
