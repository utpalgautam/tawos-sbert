    Ti.API.info(""""""""******* loading event fired!!! ************"""""""");  });  mapview.addEventListener('singletap', function(){    Ti.API.info(""""""""******* singletap event fired!!! ************"""""""");  });  mapview.addEventListener('swipe', function(){    Ti.API.info(""""""""******* swipe event fired!!! ************"""""""");  });  mapview.addEventListener('twofingertap', function(){    Ti.API.info(""""""""******* twofingertap event fired!!! ************"""""""");  });  {code}""""""",Bug,"Title: with the exception of the loading, complete and regionChanged events, most mapview events do not fire
