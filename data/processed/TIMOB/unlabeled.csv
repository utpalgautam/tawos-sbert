TIMOB-5501,12,"""MobileWeb: Tab has height == 0 when it is not defined in the source code""","""""""Tab has height == 0 when it is not defined in the source code. Objects which are added to the Tab appear outside the tab.  Example: switch to the Tab 2.  {code:JavaScript}  var win = Ti.UI.createWindow();  win.open();  var tg = Ti.UI.createTabGroup({});  win.add(tg);  var tab1 = Ti.UI.createTab({   title: """"""""tab 1"""""""",   width:200,  });  tg.addTab(tab1);    var l1 = Ti.UI.createLabel({   text: """"""""this is tab 1"""""""",   left: 100,   top: 100  });    tab1.add(l1);    var tab2 = Ti.UI.createTab({   title: """"""""tab 2"""""""",   backgroundColor:'green',   height: 100,  });  tg.addTab(tab2);      var l2 = Ti.UI.createLabel({   text: """"""""this is tab 2"""""""",   left: 200,   top: 200,   backgroundColor:'red'  });  tab2.add(l2);      var tab3 = Ti.UI.createTab({   title: """"""""tab 3"""""""",   width:100,  });  tg.addTab(tab3);      var l3 = Ti.UI.createLabel({   text: """"""""this is tab 3"""""""",   left: 300,   top: 300  });  tab3.add(l3);  {code}""""""",Bug,"Title: MobileWeb: Tab has height == 0 when it is not defined in the source code
Description: """"Tab has height == 0 when it is not defined in the source code. Objects which are added to the Tab appear outside the tab. Example: switch to the Tab 2. {code:JavaScript} var win = Ti.UI.createWindow(); win.open(); var tg = Ti.UI.createTabGroup({}); win.add(tg); var tab1 = Ti.UI.createTab({ title: """"""""tab 1"""""""", width:200, }); tg.addTab(tab1); var l1 = Ti.UI.createLabel({ text: """"""""this is tab 1"""""""", left: 100, top: 100 }); tab1.add(l1); var tab2 = Ti.UI.createTab({ title: """"""""tab 2"""""""", backgroundColor:'green', height: 100, }); tg.addTab(tab2); var l2 = Ti.UI.createLabel({ text: """"""""this is tab 2"""""""", left: 200, top: 200, backgroundColor:'red' }); tab2.add(l2); var tab3 = Ti.UI.createTab({ title: """"""""tab 3"""""""", width:100, }); tg.addTab(tab3); var l3 = Ti.UI.createLabel({ text: """"""""this is tab 3"""""""", left: 300, top: 300 }); tab3.add(l3); {code}""""",title+description
