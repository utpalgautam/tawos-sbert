TIMOB-15702,12,"""Android: random contentOffset value of ScrollView when ScrollableView with TableView/ListView inside ScrollView""","""""""1. scroll scrollableView  2. suddenly scrollView makes jump to some strange position  3. contentOffset(ie. scroll position) was changed, and 'scroll' event of scrollView was also triggered.          {code:JavaScript}  var win = Ti.UI.createWindow({      backgroundColor : 'white',  });    var scroll = Ti.UI.createScrollView({      layout : 'vertical'  });    var header = Ti.UI.createView({ height: 300, backgroundColor:'green' });  scroll.add(header);    var views = [];    for (var k=0; k<3; k++) {  var rows = [];  for (var i=0; i<10; i++) {      var row = Ti.UI.createTableViewRow({ height: 48 });      var icon = Ti.UI.createImageView({ width: 32, height: 32, image: """"""""/appicon.png"""""""" });      row.push(icon);  }    var table = Ti.UI.createTableView({      data: rows,  });  views.push(table);  }      var scrollable = Ti.UI.createScrollableView({      height : 400,      views : views,  });    win.add(scroll);  win.open();  {code}  """"""",Bug,"Title: Android: random contentOffset value of ScrollView when ScrollableView with TableView/ListView inside ScrollView
Description: """"1. scroll scrollableView 2. suddenly scrollView makes jump to some strange position 3. contentOffset(ie. scroll position) was changed, and 'scroll' event of scrollView was also triggered. {code:JavaScript} var win = Ti.UI.createWindow({ backgroundColor : 'white', }); var scroll = Ti.UI.createScrollView({ layout : 'vertical' }); var header = Ti.UI.createView({ height: 300, backgroundColor:'green' }); scroll.add(header); var views = []; for (var k=0; k<3; k++) { var rows = []; for (var i=0; i<10; i++) { var row = Ti.UI.createTableViewRow({ height: 48 }); var icon = Ti.UI.createImageView({ width: 32, height: 32, image: """"""""/appicon.png"""""""" }); row.push(icon); } var table = Ti.UI.createTableView({ data: rows, }); views.push(table); } var scrollable = Ti.UI.createScrollableView({ height : 400, views : views, }); win.add(scroll); win.open(); {code} """"",title+description
