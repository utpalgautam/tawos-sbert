TIMOB-10172,12,"""iOS: Ti.UI.TableView.insertRowBefore does not work after delete a row""","""""""Problem:  ========  Ti.UI.TableView.insertRowBefore does not work after delete a row    Reproduction:  =============  - insert 2 rows by pressing '+' (list: 2, 1)  - swipe first row to delete '2' item (list: 1)  - '+' will not work more (insertRowBefore does not work)    Sample Code (app.js):  =====================    var self = Ti.UI.createWindow({ modal: true });  var tableView = Ti.UI.createTableView({ editable: true});  self.add(tableView);  var id = 0;  var addButton = Ti.UI.createButton({ systemButton: Ti.UI.iPhone.SystemButton.ADD });  addButton.addEventListener('click', function() {   var tableRow = Ti.UI.createTableViewRow({ title: '' + ++id });     tableView.data.length ? tableView.insertRowBefore(0, tableRow) : tableView.appendRow(tableRow);  });  self.rightNavButton = addButton;  self.open();  """"""",Bug,"Title: iOS: Ti.UI.TableView.insertRowBefore does not work after delete a row
Description: """"Problem: ======== Ti.UI.TableView.insertRowBefore does not work after delete a row Reproduction: ============= - insert 2 rows by pressing '+' (list: 2, 1) - swipe first row to delete '2' item (list: 1) - '+' will not work more (insertRowBefore does not work) Sample Code (app.js): ===================== var self = Ti.UI.createWindow({ modal: true }); var tableView = Ti.UI.createTableView({ editable: true}); self.add(tableView); var id = 0; var addButton = Ti.UI.createButton({ systemButton: Ti.UI.iPhone.SystemButton.ADD }); addButton.addEventListener('click', function() { var tableRow = Ti.UI.createTableViewRow({ title: '' + ++id }); tableView.data.length ? tableView.insertRowBefore(0, tableRow) : tableView.appendRow(tableRow); }); self.rightNavButton = addButton; self.open(); """"",title+description
TIMOB-10171,12,"""Android: When dynamically adding route points to a map over time causes app to crash""","""""""I am tracking a user running and updating a map with a route. After a certain amount of points are added to the route I get the below error:           1. Run this code, interact with screen, and you should be able to see this in ~5 seconds.    """"""",Bug,"Title: Android: When dynamically adding route points to a map over time causes app to crash
