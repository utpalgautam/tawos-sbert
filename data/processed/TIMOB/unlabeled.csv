TIMOB-6873,12,"""Android: Inconsistent Focus and Blur events with Textfield in TableViewRow""","""""""h3.Issue  Focus and Blur Events are getting triggered slightly different as they are on iPhone Platform.    They are getting triggered for each and every digit/character entered by the user even if he/she is entering the data in the same Text Field.    h6.Tested on  iOS Simulator / iPhone 3Gs iOS 5  Android HVGA Emulator / LG Ally v2.2.1    h6.Expected behavior  While entering to a Text Field Focus got fired once  While selecting another TextField, Blur - Focus got fired (in that order, once).    h6.Unexpected behavior  While entering to a Text Field Focus got fired twice, and every time a digit is entered  While selecting another TextField, Blur - Focus got fired TWICE, and every time digits are entered.    h6.Steps to reproduce  1) Select a TextField  2) Select any other TextFields in order to trigger Blur and Focus events respectively  3) Notice the difference between each platform    h6.Repro sequence  This sample uses an """"""""alert box"""""""" to reproduce the issue.    {code:title=app.js}  var win = Ti.UI.createWindow({   softInputMode : (Titanium.UI.Android) ? Ti.UI.Android.SOFT_INPUT_ADJUST_PAN : '',   windowSoftInputMode : (Titanium.UI.Android) ? Ti.UI.Android.SOFT_INPUT_ADJUST_PAN : ''  });    var tf1 = null;    function addRow() {   var row = Ti.UI.createTableViewRow({    height : 80,    //touchEnabled:false   });      tf1 = Titanium.UI.createTextField({    color : '#336699',    width : 250,    height : 80,    focusable : true,    returnKeyType : Titanium.UI.RETURNKEY_DONE,    //autocapitalization : Titanium.UI.TEXT_AUTOCAPITALIZATION_WORDS,    autocorrect : false,    suppressReturn : true,     });      tf1.addEventListener('focus', function() {    Ti.API.info('Focus fired');    alert('Focus fired');   });     tf1.addEventListener('blur', function() {    Ti.API.info('blur fired');    alert('Blur fired');   });      row.add(tf1);   //row.selectionStyle = Ti.UI.iPhone.TableViewCellSelectionStyle.NONE;   //row.className = 'control';   return row;  }    // create table view data object  var data = [];    for(var x = 0; x < 10; x++) {   data[x] = addRow();  }    var tableView = Ti.UI.createTableView({   data : data,   //style : Titanium.UI.iPhone.TableViewStyle.GROUPED  });    win.add(tableView);    win.open();  {code}    h6.Customer's remarks  """"""",Bug,"Title: Android: Inconsistent Focus and Blur events with Textfield in TableViewRow
Description: """"h3.Issue Focus and Blur Events are getting triggered slightly different as they are on iPhone Platform. They are getting triggered for each and every digit/character entered by the user even if he/she is entering the data in the same Text Field. h6.Tested on iOS Simulator / iPhone 3Gs iOS 5 Android HVGA Emulator / LG Ally v2.2.1 h6.Expected behavior While entering to a Text Field Focus got fired once While selecting another TextField, Blur - Focus got fired (in that order, once). h6.Unexpected behavior While entering to a Text Field Focus got fired twice, and every time a digit is entered While selecting another TextField, Blur - Focus got fired TWICE, and every time digits are entered. h6.Steps to reproduce 1) Select a TextField 2) Select any other TextFields in order to trigger Blur and Focus events respectively 3) Notice the difference between each platform h6.Repro sequence This sample uses an """"""""alert box"""""""" to reproduce the issue. {code:title=app.js} var win = Ti.UI.createWindow({ softInputMode : (Titanium.UI.Android) ? Ti.UI.Android.SOFT_INPUT_ADJUST_PAN : '', windowSoftInputMode : (Titanium.UI.Android) ? Ti.UI.Android.SOFT_INPUT_ADJUST_PAN : '' }); var tf1 = null; function addRow() { var row = Ti.UI.createTableViewRow({ height : 80, //touchEnabled:false }); tf1 = Titanium.UI.createTextField({ color : '#336699', width : 250, height : 80, focusable : true, returnKeyType : Titanium.UI.RETURNKEY_DONE, //autocapitalization : Titanium.UI.TEXT_AUTOCAPITALIZATION_WORDS, autocorrect : false, suppressReturn : true, }); tf1.addEventListener('focus', function() { Ti.API.info('Focus fired'); alert('Focus fired'); }); tf1.addEventListener('blur', function() { Ti.API.info('blur fired'); alert('Blur fired'); }); row.add(tf1); //row.selectionStyle = Ti.UI.iPhone.TableViewCellSelectionStyle.NONE; //row.className = 'control'; return row; } // create table view data object var data = []; for(var x = 0; x < 10; x++) { data[x] = addRow(); } var tableView = Ti.UI.createTableView({ data : data, //style : Titanium.UI.iPhone.TableViewStyle.GROUPED }); win.add(tableView); win.open(); {code} h6.Customer's remarks """"",title+description
TIMOB-6872,12,"""KitchenSink: enable xhr_fileupload.js for Android and test that script is successful""","""""""Enable file upload example in [xhr.js#L16|https://github.com/<USER>titanium_mobile/blob/master/demos/KitchenSink/Resources/examples/xhr.js#L16] and confirm that script is successful (without the need for an image in photo gallery, so that it can be tested in emulator)""""""",Bug,"Title: KitchenSink: enable xhr_fileupload.js for Android and test that script is successful
