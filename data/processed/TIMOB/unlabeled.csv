(TiUIDialog.java:92) E/AndroidRuntime( 2042): at ti.modules.titanium.ui.widget.TiUIDialog.show(TiUIDialog.java:256) E/AndroidRuntime( 2042): at ti.modules.titanium.ui.AlertDialogProxy$1.run(AlertDialogProxy.java:73) E/AndroidRuntime( 2042): at android.os.Handler.handleCallback(Handler.java:615) E/AndroidRuntime( 2042): at android.os.Handler.dispatchMessage(Handler.java:92) E/AndroidRuntime( 2042): at android.os.Looper.loop(Looper.java:137) E/AndroidRuntime( 2042): at android.app.ActivityThread.main(ActivityThread.java:4745) E/AndroidRuntime( 2042): at java.lang.reflect.Method.invokeNative(Native Method) E/AndroidRuntime( 2042): at java.lang.reflect.Method.invoke(Method.java:511) E/AndroidRuntime( 2042): at com.android.internal.os.ZygoteInit$MethodAndArgsCaller.run(ZygoteInit.java:786) E/AndroidRuntime( 2042): at com.android.internal.os.ZygoteInit.main(ZygoteInit.java:553) E/AndroidRuntime( 2042): at dalvik.system.NativeStart.main(Native Method) {code} This appears to be happening because the TiUIDialogProxy.hide() method sets the custom view to null. The workaround is to set the androidView property on the dialog immediately before calling show() instead of setting it in the creation dict as illustrated below: {code:javascript} var win = Ti.UI.createWindow({ backgroundColor: 'white' }); var view = Ti.UI.createView({ }); var alertDialog = Ti.UI.createAlertDialog({ androidView: view, // for workaround, remove this line buttonNames: [""""""""Ok"""""""", """"""""Close""""""""], cancel: 1 }); var button = Ti.UI.createButton({ title: 'Show Dialog' }); button.addEventListener('click', function(e) { // alertDialog.androidView = view; // for workaround, uncomment this line alertDialog.show(); }); win.add(button); win.open(); {code}""""",title+description
