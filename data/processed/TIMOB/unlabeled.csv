TIMOB-5570,12,"""MobileWeb: not working event 'error' in webView""","""""""Can't represent event 'error' in webView. Event 'load' fired when loading any type of URL.  {code:JavaScript}  var win = Ti.UI.currentWindow;    var tf = Ti.UI.createTextField({   left: 10,   top: 5,   width: 320,   height: 40  });    var webView = Ti.UI.createWebView({   top: 50,   left: 10,   width: 300,   height: 300,   url: 'google.com/404',   backgroundColor: 'red'  });    win.add(tf);  win.add(webView);    tf.addEventListener('return',function(){   webView.url = tf.value;  });    webView.addEventListener('beforeload', function(){   alert('Page loading begins');  });    webView.addEventListener('load',function(){   alert('Page loaded');  });    webView.addEventListener('error',function(){   alert('page cannot be load');  });    {code}""""""",Bug,"Title: MobileWeb: not working event 'error' in webView
Description: """"Can't represent event 'error' in webView. Event 'load' fired when loading any type of URL. {code:JavaScript} var win = Ti.UI.currentWindow; var tf = Ti.UI.createTextField({ left: 10, top: 5, width: 320, height: 40 }); var webView = Ti.UI.createWebView({ top: 50, left: 10, width: 300, height: 300, url: 'google.com/404', backgroundColor: 'red' }); win.add(tf); win.add(webView); tf.addEventListener('return',function(){ webView.url = tf.value; }); webView.addEventListener('beforeload', function(){ alert('Page loading begins'); }); webView.addEventListener('load',function(){ alert('Page loaded'); }); webView.addEventListener('error',function(){ alert('page cannot be load'); }); {code}""""",title+description
TIMOB-5569,12,"""MobileWeb: Touch events problems with textArea and textField""","""""""I set eventlisteners for touch events(doubletap, twofingertap, touchstart, touchmove, etc) on textArea object. When i try to reproduce these events on iPhone the textArea becomes focused and the iPhone keyboard appears on the screen, but events not fired. The same problem is with textField.  Detail. Event singletap works correctly.   """"""",Bug,"Title: MobileWeb: Touch events problems with textArea and textField
Description: """"I set eventlisteners for touch events(doubletap, twofingertap, touchstart, touchmove, etc) on textArea object. When i try to reproduce these events on iPhone the textArea becomes focused and the iPhone keyboard appears on the screen, but events not fired. The same problem is with textField. Detail. Event singletap works correctly. """"",title+description
