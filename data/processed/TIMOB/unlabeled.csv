TIMOB-17172,12,"""iOS: Crash with TableViewRow object to a TableView inside a ScrollView""","""""""I have a UI design with: ScrollView with layout='vertical', a view at height=Ti.UI.SIZE and a TableView at height=Ti.UI.SIZE and scrollable=false.   When I try to add a TableViewRow object to TableView, the app closes.    This code reproduces the problem.    {code:title=app.js}  var w = Titanium.UI.createWindow({   fullscreen: true,   backgroundColor: 'silver'  });    var s = Ti.UI.createScrollView({   layout: 'vertical' /* composite crash too */  });    var v = Ti.UI.createView({   height: Ti.UI.SIZE /* Ti.UI.FILL works */  });    var t = Ti.UI.createTableView({   data: [{title: '1'}, {title: '1'}, {title: '1'}, {title: '1'}, {title: '1'}, {title: '1'}, {title: '1'}, {title: '1'}, {title: '1'}, {title: '1'}],   height: Ti.UI.SIZE,   //backgroundColor: 'white',   top: '200dp',   scrollable: false  });    v.add(t);  s.add(v);  w.add(s);    setTimeout(function () {   t.backgroundColor = 'yellow';     t.setData([{    title: 'dictionaty works'   }]);      t.appendRow({    title: 'it will appears only later'   });     setTimeout(function () {    t.backgroundColor = 'red';        t.setData([Ti.UI.createTableViewRow({     title: 'app will close'    })]);        alert('not called');   }, 2000);  }, 2000);    w.open();  {code}""""""",Bug,"Title: iOS: Crash with TableViewRow object to a TableView inside a ScrollView
Description: """"I have a UI design with: ScrollView with layout='vertical', a view at height=Ti.UI.SIZE and a TableView at height=Ti.UI.SIZE and scrollable=false. When I try to add a TableViewRow object to TableView, the app closes. This code reproduces the problem. {code:title=app.js} var w = Titanium.UI.createWindow({ fullscreen: true, backgroundColor: 'silver' }); var s = Ti.UI.createScrollView({ layout: 'vertical' /* composite crash too */ }); var v = Ti.UI.createView({ height: Ti.UI.SIZE /* Ti.UI.FILL works */ }); var t = Ti.UI.createTableView({ data: [{title: '1'}, {title: '1'}, {title: '1'}, {title: '1'}, {title: '1'}, {title: '1'}, {title: '1'}, {title: '1'}, {title: '1'}, {title: '1'}], height: Ti.UI.SIZE, //backgroundColor: 'white', top: '200dp', scrollable: false }); v.add(t); s.add(v); w.add(s); setTimeout(function () { t.backgroundColor = 'yellow'; t.setData([{ title: 'dictionaty works' }]); t.appendRow({ title: 'it will appears only later' }); setTimeout(function () { t.backgroundColor = 'red'; t.setData([Ti.UI.createTableViewRow({ title: 'app will close' })]); alert('not called'); }, 2000); }, 2000); w.open(); {code}""""",title+description
