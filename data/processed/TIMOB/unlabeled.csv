Description: """"In order to follow convention, move the following Ti.UI.EmailDialog constants to [Titanium.UI|http://developer.<USER>com/apidoc/mobile/latest/Titanium.UI-module]: * [CANCELLED|http://developer.<USER>com/apidoc/mobile/latest/Titanium.UI.EmailDialog.CANCELLED-property.html] * [FAILED|http://developer.<USER>com/apidoc/mobile/latest/Titanium.UI.EmailDialog.FAILED-property.html] * [SAVED|http://developer.<USER>com/apidoc/mobile/latest/Titanium.UI.EmailDialog.SAVED-property.html] * [SENT|http://developer.<USER>com/apidoc/mobile/latest/Titanium.UI.EmailDialog.SENT-property.html] This was at stramer's request, [here|https://github.com/<USER>titanium_mobile/pull/1470#r486739]""""",title+description
TIMOB-7803,12,"""iOS: DashboardView - Stress testing code crashes app""","""""""Steps to reproduce:  1. Install and run the following code:    {code:title=app.js}  var mainWindow = Titanium.UI.createWindow({        backgroundColor:'#fff'  });    var dashboardView;    var createDashboardItem = function(index) {   var item, label;      item = Titanium.UI.createDashboardItem({    canDelete : true   });     label = Titanium.UI.createLabel({    borderColor: 'red',    borderWidth: 1,    text : 'build 6:' + index,    color : 'red',    textAlign : 'center'   });       item.add(label);     item.addEventListener('removeData',function(){    item.remove(label);    Ti.API.debug('Cleaning '+index);   });     return item;  };    var updateDashboard = function() {   var i, dashboardData;      if (dashboardView) {    dashboardData=dashboardView.data;    mainWindow.remove(dashboardView);    for(i = 0; i < 4; i++) {     dashboardData[i].fireEvent('removeData');    }     dashboardView = null;   }     dashboardData = [];     for(i = 0; i < 4; i++) {    dashboardData.push(createDashboardItem(i));   }   // Here we should ideally just do this:   //   // dashboardView.data = dashboardData;   //   // but that completely messes up the DashboardView.   // Related JIRA ticket:   //    http://jira.<USER>org/browse/TIMOB-2635      dashboardView = Titanium.UI.createDashboardView({    height : 400,    width : 300,    top : 15,    left : 10   });   dashboardView.data = dashboardData;   mainWindow.add(dashboardView);  };    // updateDashboard sets dashboardView and adds it to mainWindow  updateDashboard();    var button1 = Ti.UI.createButton({   title: 'Refresh',   width: 100, height: 40, bottom: 0,   left:0  });  button1.addEventListener('click', function(){   updateDashboard();  });    mainWindow.add(button1);    mainWindow.open();    setInterval(updateDashboard,200);  {code}    2. Quickly press the flashing squares    Actual: App will crash. See attachments  Expected: App should not crash    Note: Bug still occurs in 1.8.1""""""",Bug,"Title: iOS: DashboardView - Stress testing code crashes app
Description: """"Steps to reproduce: 1. Install and run the following code: {code:title=app.js} var mainWindow = Titanium.UI.createWindow({ backgroundColor:'#fff' }); var dashboardView; var createDashboardItem = function(index) { var item, label; item = Titanium.UI.createDashboardItem({ canDelete : true }); label = Titanium.UI.createLabel({ borderColor: 'red', borderWidth: 1, text : 'build 6:' + index, color : 'red', textAlign : 'center' }); item.add(label); item.addEventListener('removeData',function(){ item.remove(label); Ti.API.debug('Cleaning '+index); }); return item; }; var updateDashboard = function() { var i, dashboardData; if (dashboardView) { dashboardData=dashboardView.data; mainWindow.remove(dashboardView); for(i = 0; i < 4; i++) { dashboardData[i].fireEvent('removeData'); } dashboardView = null; } dashboardData = []; for(i = 0; i < 4; i++) { dashboardData.push(createDashboardItem(i)); } // Here we should ideally just do this: // // dashboardView.data = dashboardData; // // but that completely messes up the DashboardView. // Related JIRA ticket: // http://jira.<USER>org/browse/TIMOB-2635 dashboardView = Titanium.UI.createDashboardView({ height : 400, width : 300, top : 15, left : 10 }); dashboardView.data = dashboardData; mainWindow.add(dashboardView); }; // updateDashboard sets dashboardView and adds it to mainWindow updateDashboard(); var button1 = Ti.UI.createButton({ title: 'Refresh', width: 100, height: 40, bottom: 0, left:0 }); button1.addEventListener('click', function(){ updateDashboard(); }); mainWindow.add(button1); mainWindow.open(); setInterval(updateDashboard,200); {code} 2. Quickly press the flashing squares Actual: App will crash. See attachments Expected: App should not crash Note: Bug still occurs in 1.8.1""""",title+description
TIMOB-7802,12,"""Android: Module License: v8/rhino: The alert indicating that you are not licensed to use the module can be dismissed from back or click on the background""","""""""Steps To Reproduce:  1. Compile the attached application and run on device  2. When the license alert is displayed on 4.0.2 device click on the background and on 2.3.6 device click the hardware back button    Actual:  The alert is dismissed and the user can continue to use the application    Expected:  Should not be able to dismiss the alert except by pressing ok to quit the application""""""",Bug,"Title: Android: Module License: v8/rhino: The alert indicating that you are not licensed to use the module can be dismissed from back or click on the background
Description: """"Steps To Reproduce: 1. Compile the attached application and run on device 2. When the license alert is displayed on 4.0.2 device click on the background and on 2.3.6 device click the hardware back button Actual: The alert is dismissed and the user can continue to use the application Expected: Should not be able to dismiss the alert except by pressing ok to quit the application""""",title+description
