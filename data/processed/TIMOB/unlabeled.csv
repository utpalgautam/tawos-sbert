seActivity.sendMessage(TiBaseActivity.java:304)<br> E/TiBaseActivity( 3711): at org.<USER>titanium.TiBaseActivity.onCreate(TiBaseActivity.java:294)<br> E/TiBaseActivity( 3711): at android.app.Instrumentation.callActivityOnCreate(Instrumentation.java:1123)<br> E/TiBaseActivity( 3711): at android.app.ActivityThread.performLaunchActivity(ActivityThread.java:2364)<br> E/TiBaseActivity( 3711): at android.app.ActivityThread.handleLaunchActivity(ActivityThread.java:2417)<br> E/TiBaseActivity( 3711): at android.app.ActivityThread.access$2100(ActivityThread.java:116)<br> E/TiBaseActivity( 3711): at android.app.ActivityThread$H.handleMessage(ActivityThread.java:1794)<br> E/TiBaseActivity( 3711): at android.os.Handler.dispatchMessage(Handler.java:99)<br> E/TiBaseActivity( 3711): at android.os.Looper.loop(Looper.java:123)<br> E/TiBaseActivity( 3711): at android.app.ActivityThread.main(ActivityThread.java:4203)<br> E/TiBaseActivity( 3711): at java.lang.reflect.Method.invokeNative(Native Method)<br> E/TiBaseActivity( 3711): at java.lang.reflect.Method.invoke(Method.java:521)<br> E/TiBaseActivity( 3711): at com.android.internal.os.ZygoteInit$MethodAndArgsCaller.run(ZygoteInit.java:791)<br> E/TiBaseActivity( 3711): at com.android.internal.os.ZygoteInit.main(ZygoteInit.java:549)<br> E/TiBaseActivity( 3711): at dalvik.system.NativeStart.main(Native Method)<br> E/TiBaseActivity( 3711): (main) [112,3682] Unable to message creator. finishing.<br> E/TiBaseActivity( 3711): java.lang.RuntimeException: Can't marshal objects across processes.<br> E/TiBaseActivity( 3711): at android.os.Message.writeToParcel(Message.java:385)<br> E/TiBaseActivity( 3711): at android.os.IMessenger$Stub$Proxy.send(IMessenger.java:85)<br> E/TiBaseActivity( 3711): at android.os.Messenger.send(Messenger.java:50)<br> E/TiBaseActivity( 3711): at org.<USER>titanium.TiBaseActivity.handleSendMessage(TiBaseActivity.java:316)<br> E/TiBaseActivity( 3711): at org.<USER>titanium.TiBaseActivity$3.run(TiBaseActivity.java:307)<b