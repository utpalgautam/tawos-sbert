Description: """"After all the tests in drillbit have finished running, you see this error message in the console whenever new data comes from the android emulator: We need to make sure to check if the log is currently open before trying to write to it's filestream.""""",title+description
TIMOB-4367,12,"""Android: Table View Row Memory Leak""","""""""h1. Problem  Table view rows that you create are never released.    h2. Reproduction  1. Drop the following in an app.js  2. Load up DDMS and watch the Allocations or Sysinfo / Memory usage.  3. Touch the """"""""Create big table view"""""""" button in the app; a table view with 1500 rows will be created.  4. Refresh the sysinfo and see how the memory footprint has grown.  5. Hit the """"""""Back"""""""" button in the app; the window is closed and the variables nullified.  6. Refresh the sysinfo and see that the memory footprint hasn't changed.  7. Repeat steps 3-7 and the memory footprint will only continue to grow.    {code:title=app.js}  var win = Ti.UI.createWindow({ backgroundColor:'#fff' });    var btn = Ti.UI.createButton({      color: 'black', layout:'center',      title: 'Create big table view'  });  win.add(btn);  win.open();  btn.addEventListener('click', function() {      var newWin = Ti.UI.createWindow({          backgroundColor: '#fff',          layout:'vertical'      });      var back = Ti.UI.createButton({          color: 'black', top: 10,          title: 'Back'      });      newWin.add(back);        var tv = createBigTableView();      newWin.add(tv);      newWin.open();        function clickListener() {          back.removeEventListener('click', clickListener);          newWin.close();          tv.data = null;          tv = null;          newWin = null;          back = null;      }        back.addEventListener('click', clickListener);  });    function createBigTableView() {      var data = [];      for (i = 1; i <= 1500; i++) {          data.push(createCustomTableViewRow('RowsNMore', i));      }      return Ti.UI.createTableView({          top:0, bottom:0, left:0, right:0,          separatorColor: 'white',          data: data      });  }    function createCustomTableViewRow(label1text, label2text) {      var row = Ti.UI.createTableViewRow({ className: 'customTVRow' });      var vw = Ti.UI.createView({layout: 'vertical'});      row.add(vw);      vw.add(Ti.UI.createLabel({          text: label1text, color: 'black',          font: {fontSize: '9pt', fontWeight: 'bold'}      }));      vw.add(Ti.UI.createLabel({          text: label2text, color: 'gray',          font: {fontSize: '7pt', fontWeight: 'normal'}      }));      return row;  }  {code}    h3. Associated Helpdesk Ticket  http://appc.me/c/APP-321721""""""",Bug,"Title: Android: Table View Row Memory Leak
Description: """"h1. Problem Table view rows that you create are never released. h2. Reproduction 1. Drop the following in an app.js 2. Load up DDMS and watch the Allocations or Sysinfo / Memory usage. 3. Touch the """"""""Create big table view"""""""" button in the app; a table view with 1500 rows will be created. 4. Refresh the sysinfo and see how the memory footprint has grown. 5. Hit the """"""""Back"""""""" button in the app; the window is closed and the variables nullified. 6. Refresh the sysinfo and see that the memory footprint hasn't changed. 7. Repeat steps 3-7 and the memory footprint will only continue to grow. {code:title=app.js} var win = Ti.UI.createWindow({ backgroundColor:'#fff' }); var btn = Ti.UI.createButton({ color: 'black', layout:'center', title: 'Create big table view' }); win.add(btn); win.open(); btn.addEventListener('click', function() { var newWin = Ti.UI.createWindow({ backgroundColor: '#fff', layout:'vertical' }); var back = Ti.UI.createButton({ color: 'black', top: 10, title: 'Back' }); newWin.add(back); var tv = createBigTableView(); newWin.add(tv); newWin.open(); function clickListener() { back.removeEventListener('click', clickListener); newWin.close(); tv.data = null; tv = null; newWin = null; back = null; } back.addEventListener('click', clickListener); }); function createBigTableView() { var data = []; for (i = 1; i <= 1500; i++) { data.push(createCustomTableViewRow('RowsNMore', i)); } return Ti.UI.createTableView({ top:0, bottom:0, left:0, right:0, separatorColor: 'white', data: data }); } function createCustomTableViewRow(label1text, label2text) { var row = Ti.UI.createTableViewRow({ className: 'customTVRow' }); var vw = Ti.UI.createView({layout: 'vertical'}); row.add(vw); vw.add(Ti.UI.createLabel({ text: label1text, color: 'black', font: {fontSize: '9pt', fontWeight: 'bold'} })); vw.add(Ti.UI.createLabel({ text: label2text, color: 'gray', font: {fontSize: '7pt', fontWeight: 'normal'} })); return row; } {code} h3. Associated Helpdesk Ticket http://appc.me/c/APP-321721""""",title+description
TIMOB-4366,12,"""iOS: Support Ti.UI.createNotification""","""""""h1. Feature  Android has support for toast notifications through the method """"""""Ti.UI.createNotification"""""""". We can expand this to support iOS as well, and add documentation to the APIDocs.    I'm aware this isn't a native feature of iOS, but it's still something useful we could offer our users. And it shouldn't be too difficult to do, because we already show similar notifications in the kitchen sink using [pure JavaScript|https://github.com/<USER>titanium_mobile/blob/master/demos/KitchenSink/Resources/app.js#L103].    h2. Sample Code  The following works on Android:  {code:title=app.js}  Ti.UI.createNotification({ message : 'Hello, World!' }).show();  {code}    h3. Associated Helpdesk Ticket  http://appc.me/c/HNU-68239-489""""""",New Feature,"Title: iOS: Support Ti.UI.createNotification
Description: """"h1. Feature Android has support for toast notifications through the method """"""""Ti.UI.createNotification"""""""". We can expand this to support iOS as well, and add documentation to the APIDocs. I'm aware this isn't a native feature of iOS, but it's still something useful we could offer our users. And it shouldn't be too difficult to do, because we already show similar notifications in the kitchen sink using [pure JavaScript|https://github.com/<USER>titanium_mobile/blob/master/demos/KitchenSink/Resources/app.js#L103]. h2. Sample Code The following works on Android: {code:title=app.js} Ti.UI.createNotification({ message : 'Hello, World!' }).show(); {code} h3. Associated Helpdesk Ticket http://appc.me/c/HNU-68239-489""""",title+description
TIMOB-4365,12,"""iOS - Scrollable view does not have a """"scale"""" event""","""""""The scrollable view has the zooming feature but it does not have a scale event. If the scrollable view is scalable, the """"""""scale"""""""" event should be implemented.    Sample code: https://gist.github.com/1019492  Helpdesk Ticket: APP-334778""""""",Bug,"Title: iOS - Scrollable view does not have a """"scale"""" event
