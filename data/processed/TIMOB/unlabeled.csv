TIMOB-786,12,"""crash using 'this' in removeEventListener""","""""""{html}<div><p>add this code to app.js</p> <p>Ti.App.addEventListener('hello', function(){<br></p> <pre> <code>Ti.API.info('Hello event fired!'); Ti.App.removeEventListener('hello', this);</code> </pre> <p>});</p> <p>Ti.App.fireEvent('hello');</p></div>{html}""""""",Bug,"Title: crash using 'this' in removeEventListener
