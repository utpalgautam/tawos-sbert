e.row; var rowdata = e.rowData; Titanium.UI.createAlertDialog({title:'Table View',message:'row ' + row + ' index ' + index + ' section ' + section + ' row data ' + rowdata}).show(); }); // add table view to the window Titanium.UI.currentWindow.add(tableview); {code}""""",title+description
