VideoTrack = localMedia.addVideoTrack(true, cameraCapturer);          primaryVideoView.setMirror(true);          localVideoTrack.addRenderer(primaryVideoView);          localVideoView = primaryVideoView;      };  })(arguments[0] || {});  var requestPermissionForCameraAndMicrophone = function() {      var permissions = [];      permissions.push('android.permission.CAMERA');      permissions.push('android.permission.RECORD_AUDIO');        Ti.Android.requestPermissions(permissions, function(e) {          Ti.API.info('eee' + JSON.stringify(e));          if (e.success) {              Ti.API.info(""""""""SUCCESS"""""""");          } else {              Ti.API.info(""""""""ERROR: """""""" + e.error);          }      });  };    {code}    index.xml code    {code}  <Alloy>      <Window class=""""""""container"""""""" id=""""""""container"""""""">                  </Window>  </Alloy>  {code}  h3. Error logs:            h3. API Library  https://media.twiliocdn.com/sdk/android/video/releases/1.0.0-beta13/docs/com/twilio/video/LocalMedia.html      h3. AAR file link:  https://bintray.com/twilio/releases/download_file?file_path=com%2Ftwilio%2Fvideo-android%2F1.0.0-beta13%2Fvideo-android-1.0.0-beta13.aar      h3. Native code ref:   https://github.com/twilio/video-quickstart-android/blob/master/quickstart/src/main/java/com/twilio/video/quickstart/activity/VideoActivity.java  """"""",Bug,"Title: Hyperloop Android: Twilio Video SDK addAudioTrack is not a function
