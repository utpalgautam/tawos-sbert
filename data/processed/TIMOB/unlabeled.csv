TIMOB-13602,12,"""Android: nine-patch image is not displayed properly""","""""""9-patch image working on SDK 3.0.2.GA is not working on 3.1.0.GA.    I can't find any problem with the image file.    The code I used:  {code:title=app.js|borderStyle=solid}   var win = Ti.UI.createWindow({       backgroundColor: 'white',       exitOnClose: true,       fullscreen: false,       title: 'Click button to test'   });       var button = Ti.UI.createButton({       backgroundImage: '/images/bt_start.png',       backgroundSelectedImage:'/images/bt_start_sel.png',       title: 'Click me!',       top: 10,       width: 300,       height: 200   });   button.addEventListener('click',function(e){       Ti.API.info(""""""""You clicked the button"""""""");   });   win.add(button);   win.open();  {code}    'bt_start.9.png' is attached.    Running that will show a result like 'scr.jpg'    When I changed the SDK to 3.0.2, it worked again.    Thank you.""""""",Bug,"Title: Android: nine-patch image is not displayed properly
Description: """"9-patch image working on SDK 3.0.2.GA is not working on 3.1.0.GA. I can't find any problem with the image file. The code I used: {code:title=app.js|borderStyle=solid} var win = Ti.UI.createWindow({ backgroundColor: 'white', exitOnClose: true, fullscreen: false, title: 'Click button to test' }); var button = Ti.UI.createButton({ backgroundImage: '/images/bt_start.png', backgroundSelectedImage:'/images/bt_start_sel.png', title: 'Click me!', top: 10, width: 300, height: 200 }); button.addEventListener('click',function(e){ Ti.API.info(""""""""You clicked the button""""""""); }); win.add(button); win.open(); {code} 'bt_start.9.png' is attached. Running that will show a result like 'scr.jpg' When I changed the SDK to 3.0.2, it worked again. Thank you.""""",title+description
