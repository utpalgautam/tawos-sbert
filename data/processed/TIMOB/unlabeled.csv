TIMOB-10860,12,"""Android: ScrollView not scrolling anymore with horizontal layout""","""""""The following code is working with 2.1.1.GA but not anymore with 2.1.2.GA    {code:js}  var views = [{title:'11111'},{title:'22222'},{title:'33333'},{title:'44444'},{title:'555555555'}];    var menu = Ti.UI.createScrollView({   contentHeight:'40dp',   top:0,   height:'40dp',   width: Ti.UI.FILL,   layout: 'horizontal',   horizontalWrap: false,   backgroundColor: 'red'  });    for(var i=0,l=views.length; i<l; i++){   var temp = Ti.UI.createView({index: i,height:'40dp',width:Ti.UI.SIZE});   temp.add(Ti.UI.createLabel({text: views[i].title,font: {fontSize: '20sp', fontWeight: 'bold'},touchEnabled:false,left:'10dp',right:'10dp',width:Ti.UI.SIZE}))   menu.add(temp);  }    var win = Ti.UI.createWindow({backgroundColor:'black',exitOnClose: true});  win.add(menu);  win.open();  {code}    With 2.1.1, it stop working if you forget the contentHeight, or set contentHeight != height    With 2.1.2, it wrap (set height to 60dp and you will see) despite the horizontalWrap=false    must be related with  https://jira.<USER>org/browse/TIMOB-9966  https://github.com/<USER>titanium_mobile/pull/2741  https://github.com/<USER>titanium_mobile/pull/2613""""""",Bug,"Title: Android: ScrollView not scrolling anymore with horizontal layout
Description: """"The following code is working with 2.1.1.GA but not anymore with 2.1.2.GA {code:js} var views = [{title:'11111'},{title:'22222'},{title:'33333'},{title:'44444'},{title:'555555555'}]; var menu = Ti.UI.createScrollView({ contentHeight:'40dp', top:0, height:'40dp', width: Ti.UI.FILL, layout: 'horizontal', horizontalWrap: false, backgroundColor: 'red' }); for(var i=0,l=views.length; i<l; i++){ var temp = Ti.UI.createView({index: i,height:'40dp',width:Ti.UI.SIZE}); temp.add(Ti.UI.createLabel({text: views[i].title,font: {fontSize: '20sp', fontWeight: 'bold'},touchEnabled:false,left:'10dp',right:'10dp',width:Ti.UI.SIZE})) menu.add(temp); } var win = Ti.UI.createWindow({backgroundColor:'black',exitOnClose: true}); win.add(menu); win.open(); {code} With 2.1.1, it stop working if you forget the contentHeight, or set contentHeight != height With 2.1.2, it wrap (set height to 60dp and you will see) despite the horizontalWrap=false must be related with https://jira.<USER>org/browse/TIMOB-9966 https://github.com/<USER>titanium_mobile/pull/2741 https://github.com/<USER>titanium_mobile/pull/2613""""",title+description
