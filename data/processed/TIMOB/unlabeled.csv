TIMOB-5647,12,"""MobileWeb: Ti.Platform.canOpenURL method not returns false if URL is unavailable""","""""""     Ti.Platform.canOpenURL method not returns false if URL is unavailable. When URL is available method returns true, if not browser generates an 404 error.        Returns true when URL = '\images', returns nothing and generates 404 error when URL = '\ima'. If URL='http://<USER>com' method returns true but when URL='http://google.com' it generates error:XMLHttpRequest cannot load http://google.com/. Origin http://html5 is not allowed by Access-Control-Allow-Origin.   {code:JavaScript}  var win = Ti.UI.currentWindow;    var ta = Ti.UI.createTextArea({   value: 'Please enter an url',   width: 200,   height: 100,   backgroundColor: '#FFF',  })    var but = Ti.UI.createButton({   title: 'check',   top: 110,   width: 100,   height: 45  });    win.add(but)  win.add(ta);    but.addEventListener('click', function(){   ta.value = Ti.Platform.canOpenURL(ta.value);  });  {code}""""""",Bug,"Title: MobileWeb: Ti.Platform.canOpenURL method not returns false if URL is unavailable
Description: """" Ti.Platform.canOpenURL method not returns false if URL is unavailable. When URL is available method returns true, if not browser generates an 404 error. Returns true when URL = '\images', returns nothing and generates 404 error when URL = '\ima'. If URL='http://<USER>com' method returns true but when URL='http://google.com' it generates error:XMLHttpRequest cannot load http://google.com/. Origin http://html5 is not allowed by Access-Control-Allow-Origin. {code:JavaScript} var win = Ti.UI.currentWindow; var ta = Ti.UI.createTextArea({ value: 'Please enter an url', width: 200, height: 100, backgroundColor: '#FFF', }) var but = Ti.UI.createButton({ title: 'check', top: 110, width: 100, height: 45 }); win.add(but) win.add(ta); but.addEventListener('click', function(){ ta.value = Ti.Platform.canOpenURL(ta.value); }); {code}""""",title+description
TIMOB-5646,12,"""MobileWeb: ImageView works incorrectly when app is deployed not in server web root""","""""""Steps:  # deploy Kitchensink in subdirectory on a webserver  # open """"""""Imageview"""""""" demo  Actual result: image path is absolute - subdirectory name is not included  Expected result: subdirectory should be included.  Hint: use Ti._5.getAbsolutePath function""""""",Bug,"Title: MobileWeb: ImageView works incorrectly when app is deployed not in server web root
Description: """"Steps: # deploy Kitchensink in subdirectory on a webserver # open """"""""Imageview"""""""" demo Actual result: image path is absolute - subdirectory name is not included Expected result: subdirectory should be included. Hint: use Ti._5.getAbsolutePath function""""",title+description
TIMOB-5645,12,"""MobileWeb: Incorrect representation of style properties in pickerRow ""","""""""When applying style properties(borderWidth, borderColor, opacity, fontStyle, etc) to the pickerRow the property become visible only when the concrete pickerRow is selected.  {code:JavaScript}  var win = Ti.UI.currentWindow;    var picker = Ti.UI.createPicker({   top: 10,   left: 10,   width: 100,   height: 40  });    p1 = Ti.UI.createPickerRow({title: 'Option1'});  p2 = Ti.UI.createPickerRow({title: 'Option2'});  p3 = Ti.UI.createPickerRow({title: 'Option3'});  p4 = Ti.UI.createPickerRow({title: 'Option4'});  p5 = Ti.UI.createPickerRow({title: 'Option5'});    win.add(picker);  picker.add(p1);  picker.add(p2);  picker.add(p3);  picker.add(p4);  picker.add(p5);    p5.backgroundColor = 'green';  p4.borderWidth = 5;  p4.borderColor = 'red';  p3.opacity = 0.5;  p2.fontStyle = 'italic';  {code} """"""",Bug,"Title: MobileWeb: Incorrect representation of style properties in pickerRow
Description: """"When applying style properties(borderWidth, borderColor, opacity, fontStyle, etc) to the pickerRow the property become visible only when the concrete pickerRow is selected. {code:JavaScript} var win = Ti.UI.currentWindow; var picker = Ti.UI.createPicker({ top: 10, left: 10, width: 100, height: 40 }); p1 = Ti.UI.createPickerRow({title: 'Option1'}); p2 = Ti.UI.createPickerRow({title: 'Option2'}); p3 = Ti.UI.createPickerRow({title: 'Option3'}); p4 = Ti.UI.createPickerRow({title: 'Option4'}); p5 = Ti.UI.createPickerRow({title: 'Option5'}); win.add(picker); picker.add(p1); picker.add(p2); picker.add(p3); picker.add(p4); picker.add(p5); p5.backgroundColor = 'green'; p4.borderWidth = 5; p4.borderColor = 'red'; p3.opacity = 0.5; p2.fontStyle = 'italic'; {code} """"",title+description
TIMOB-5644,12,"""MobileWeb: Wrong position of views in the tableViewRow when property bottom is defined.""","""""""Wrong position of views in the tableViewRow when property bottom is defined. Position of the view in the tableViewRow is top = 0.   Example:  {code:JavaScript}  var win = Ti.UI.currentWindow;  win.backgroundColor = '#EEE';    var row1 = Ti.UI.createTableViewRow({title: 'Row 1'});  var row2 = Ti.UI.createTableViewRow({title: 'Row 2'});  var row3 = Ti.UI.createTableViewRow({title: 'Row 3'});  var row4 = Ti.UI.createTableViewRow({title: 'Row 4'});    var view = Ti.UI.createView({   backgroundColor:'red',   width: 10,   height: 10,   left: 10,   bottom: 2  });    row2.add(view);    var data = [row1, row2, row3, row4];    var tableView = Ti.UI.createTableView({   width: 300,   height: 200,   top: 70,   left: 10,   backgroundColor: '#AAA',   data:data  });    var closeButton = Ti.UI.createButton({   title:'Close Window',   height:50,   width:140,   fontSize: 16,   top:10,   left:90  });    closeButton.addEventListener('click', function(){   Titanium.UI.currentWindow.close();  });        win.add(closeButton);  win.add(tableView);  {code} """"""",Bug,"Title: MobileWeb: Wrong position of views in the tableViewRow when property bottom is defined.
Description: """"Wrong position of views in the tableViewRow when property bottom is defined. Position of the view in the tableViewRow is top = 0. Example: {code:JavaScript} var win = Ti.UI.currentWindow; win.backgroundColor = '#EEE'; var row1 = Ti.UI.createTableViewRow({title: 'Row 1'}); var row2 = Ti.UI.createTableViewRow({title: 'Row 2'}); var row3 = Ti.UI.createTableViewRow({title: 'Row 3'}); var row4 = Ti.UI.createTableViewRow({title: 'Row 4'}); var view = Ti.UI.createView({ backgroundColor:'red', width: 10, height: 10, left: 10, bottom: 2 }); row2.add(view); var data = [row1, row2, row3, row4]; var tableView = Ti.UI.createTableView({ width: 300, height: 200, top: 70, left: 10, backgroundColor: '#AAA', data:data }); var closeButton = Ti.UI.createButton({ title:'Close Window', height:50, width:140, fontSize: 16, top:10, left:90 }); closeButton.addEventListener('click', function(){ Titanium.UI.currentWindow.close(); }); win.add(closeButton); win.add(tableView); {code} """"",title+description
