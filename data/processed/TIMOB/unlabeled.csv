TIMOB-7487,12,"""Adding tab to tabgroup with the same title as a previously added tab loads up the wrong tab""","""""""{code:title=app.js}    // this sets the background color of the master UIView (when there are no windows/tab groups on it)  Titanium.UI.setBackgroundColor('#000');    // create tab group  var tabGroup = Titanium.UI.createTabGroup();      //  // create base UI tab and root window  //  var win1 = Titanium.UI.createWindow({        title:'Tab 1',      backgroundColor:'#fff'  });  var tab1 = Titanium.UI.createTab({        icon:'KS_nav_views.png',      title:'Tab 1',      window:win1  });    var label1 = Titanium.UI.createLabel({   color:'#999',   text:'I am Window 1',   font:{fontSize:20,fontFamily:'Helvetica Neue'},   textAlign:'center',   width:'auto'  });    win1.add(label1);    //  // create controls tab and root window  //  var win2 = Titanium.UI.createWindow({        title:'Tab 2',      backgroundColor:'#fff'  });  var tab2 = Titanium.UI.createTab({        icon:'KS_nav_ui.png',      title:'Tab 2',      window:win2  });    var label2 = Titanium.UI.createLabel({   color:'#999',   text:'I am Window 2',   font:{fontSize:20,fontFamily:'Helvetica Neue'},   textAlign:'center',   width:'auto'  });    win2.add(label2);      var win3 = Titanium.UI.createWindow({        title:'Tab 1',      backgroundColor:'#fff'  });  var tab3 = Titanium.UI.createTab({        icon:'KS_nav_views.png',      title:'Tab 1',      window:win3  });    var label3 = Titanium.UI.createLabel({   color:'#999',   text:'I am Window 3',   font:{fontSize:20,fontFamily:'Helvetica Neue'},   textAlign:'center',   width:'auto'  });    win3.add(label3);    //  //  add tabs  //  tabGroup.addTab(tab1);    tabGroup.addTab(tab2);    tabGroup.addTab(tab3);        // open tab group  tabGroup.open();  {code}    h2. Steps to reproduce  Drop this code into app.js after creating a new project. Open the third tab.  Expect to see """"""""I am window 3"""""""". Actually seen """"""""I am WIndow 1""""""""""""""",Bug,"Title: Adding tab to tabgroup with the same title as a previously added tab loads up the wrong tab
Description: """"{code:title=app.js} // this sets the background color of the master UIView (when there are no windows/tab groups on it) Titanium.UI.setBackgroundColor('#000'); // create tab group var tabGroup = Titanium.UI.createTabGroup(); // // create base UI tab and root window // var win1 = Titanium.UI.createWindow({ title:'Tab 1', backgroundColor:'#fff' }); var tab1 = Titanium.UI.createTab({ icon:'KS_nav_views.png', title:'Tab 1', window:win1 }); var label1 = Titanium.UI.createLabel({ color:'#999', text:'I am Window 1', font:{fontSize:20,fontFamily:'Helvetica Neue'}, textAlign:'center', width:'auto' }); win1.add(label1); // // create controls tab and root window // var win2 = Titanium.UI.createWindow({ title:'Tab 2', backgroundColor:'#fff' }); var tab2 = Titanium.UI.createTab({ icon:'KS_nav_ui.png', title:'Tab 2', window:win2 }); var label2 = Titanium.UI.createLabel({ color:'#999', text:'I am Window 2', font:{fontSize:20,fontFamily:'Helvetica Neue'}, textAlign:'center', width:'auto' }); win2.add(label2); var win3 = Titanium.UI.createWindow({ title:'Tab 1', backgroundColor:'#fff' }); var tab3 = Titanium.UI.createTab({ icon:'KS_nav_views.png', title:'Tab 1', window:win3 }); var label3 = Titanium.UI.createLabel({ color:'#999', text:'I am Window 3', font:{fontSize:20,fontFamily:'Helvetica Neue'}, textAlign:'center', width:'auto' }); win3.add(label3); // // add tabs // tabGroup.addTab(tab1); tabGroup.addTab(tab2); tabGroup.addTab(tab3); // open tab group tabGroup.open(); {code} h2. Steps to reproduce Drop this code into app.js after creating a new project. Open the third tab. Expect to see """"""""I am window 3"""""""". Actually seen """"""""I am WIndow 1""""""""""""",title+description
TIMOB-7485,12,"""Android: Bit map  size exceeds VM budget""","""""""We are getting this error while opening a window with many bit map images and while clicking on the back button.  h4.Repo Steps  1. Run the application.  2. Click Vocabulary  3. then click The 100 Most Important Words.  4. click on Bebidas.  5. Now click the Word List.    At the time of loading this window you can see the below error in the android DDMS.  E/TiUIHelper(865): (main) [10,585407] Unable to load bitmap. Not enough memory: bitmap size exceeds VM budget    Please find attached the error logs for this issue.    """"""",Bug,"Title: Android: Bit map size exceeds VM budget
Description: """"We are getting this error while opening a window with many bit map images and while clicking on the back button. h4.Repo Steps 1. Run the application. 2. Click Vocabulary 3. then click The 100 Most Important Words. 4. click on Bebidas. 5. Now click the Word List. At the time of loading this window you can see the below error in the android DDMS. E/TiUIHelper(865): (main) [10,585407] Unable to load bitmap. Not enough memory: bitmap size exceeds VM budget Please find attached the error logs for this issue. """"",title+description
TIMOB-7484,12,"""Quick Scrolling of Tableview containing imageview and sounds crashes the app ""","""""""Quickly scrolling through the tableview containing imageviews and sounds etc. leads to a crash of the app. This does not happen at a fixed time. We tested this on the htc hero200 device (low-end).    The crash did not happen at a fixed time but after continuously moving through the windows containing tableview loaded with images and sounds, the tableview scroll created a black window after which the app crashed.     This happened mostly after the window was loaded and hardware back button was clicked.    I think the activity is getting closed before the tableview can load all of its contents, hence there is a null pointer exception that is being generated as can be seen in the screenshot. Please find it attached.    Attached is the crash log.  """"""",Bug,"Title: Quick Scrolling of Tableview containing imageview and sounds crashes the app
Description: """"Quickly scrolling through the tableview containing imageviews and sounds etc. leads to a crash of the app. This does not happen at a fixed time. We tested this on the htc hero200 device (low-end). The crash did not happen at a fixed time but after continuously moving through the windows containing tableview loaded with images and sounds, the tableview scroll created a black window after which the app crashed. This happened mostly after the window was loaded and hardware back button was clicked. I think the activity is getting closed before the tableview can load all of its contents, hence there is a null pointer exception that is being generated as can be seen in the screenshot. Please find it attached. Attached is the crash log. """"",title+description
TIMOB-7483,12,"""iOS: 'twofingertap' overrides all other events""","""""""h3. Issue    When a view contains a 'twofingertap' event listener, this is the only listener ever triggered, regardless of other touch event listeners.      h3. Testing        1. Try and perform all events on the view    *PASS:* Events fire correctly  *FAIL:* Only {{twofingertap}} fires""""""",Bug,"Title: iOS: 'twofingertap' overrides all other events
Description: """"h3. Issue When a view contains a 'twofingertap' event listener, this is the only listener ever triggered, regardless of other touch event listeners. h3. Testing 1. Try and perform all events on the view *PASS:* Events fire correctly *FAIL:* Only {{twofingertap}} fires""""",title+description
TIMOB-7482,12,"""Ti.API: standardize children, parent and listeners properties""","""""""h2. Request    It would be nice if """"""""children"""""""", """"""""parent"""""""" and """"""""listeners"""""""" properties were standardized for all Titanium UI components.    Currently, there is no way to traverse through whole tree of Titanium component in some context (window), or through some part of the tree.   I don't know why """"""""children"""""""" is removed from some components, but I think that's a bad idea (ok, maybe there is some valid technical reason that I don't know).    Also, there is no way of knowing what event listeners where attached to particular component. """"""""listeners"""""""" property existed once on Android (I think) but was removed.    This properties should be read-only.    h2. Current Behavior / Workaround    Currently, a workaround is to write JS wrappers for Titanium components, but for new developers that is disappointing fact because this features are basic features in some other environments. Unfortunately, there is no framework (for Titanium framework) available that does that (yet).""""""",New Feature,"Title: Ti.API: standardize children, parent and listeners properties
Description: """"h2. Request It would be nice if """"""""children"""""""", """"""""parent"""""""" and """"""""listeners"""""""" properties were standardized for all Titanium UI components. Currently, there is no way to traverse through whole tree of Titanium component in some context (window), or through some part of the tree. I don't know why """"""""children"""""""" is removed from some components, but I think that's a bad idea (ok, maybe there is some valid technical reason that I don't know). Also, there is no way of knowing what event listeners where attached to particular component. """"""""listeners"""""""" property existed once on Android (I think) but was removed. This properties should be read-only. h2. Current Behavior / Workaround Currently, a workaround is to write JS wrappers for Titanium components, but for new developers that is disappointing fact because this features are basic features in some other environments. Unfortunately, there is no framework (for Titanium framework) available that does that (yet).""""",title+description
TIMOB-7481,12,"""Ti.API: Contacts.Person - add property to store and access social network details""","""""""Add social property to [Titanium.Contacts.Person|http://developer.<USER>com/apidoc/mobile/latest/Titanium.Contacts.Person-object.html] properties, to allow twitter, facebook, flickr, LinkedIn and Myspace usernames to be saved and queried.    See [TiContactsPerson.m|https://github.com/<USER>titanium_mobile/blob/master/iphone/Classes/TiContactsPerson.m] for current implementation on iOS.    This request for the functionality to be added to iOS, and Android if possible.  """"""",New Feature,"Title: Ti.API: Contacts.Person - add property to store and access social network details
Description: """"Add social property to [Titanium.Contacts.Person|http://developer.<USER>com/apidoc/mobile/latest/Titanium.Contacts.Person-object.html] properties, to allow twitter, facebook, flickr, LinkedIn and Myspace usernames to be saved and queried. See [TiContactsPerson.m|https://github.com/<USER>titanium_mobile/blob/master/iphone/Classes/TiContactsPerson.m] for current implementation on iOS. This request for the functionality to be added to iOS, and Android if possible. """"",title+description
TIMOB-7480,12,"""iOS: packaging - First attempt to package for distribution with some projects results in error""","""""""Description:  WHile testing packaging with our pre-created Studio projects, I noticed that the first attempt to package failed with an error. This occurred regardless of using """"""""project clean"""""""". The second attempt was successful and all further attempts. THis could be related to the test projects being put in the GIT repo with no """"""""build"""""""" folder.    Studio error log:    Traceback (most recent call last):    File """"""""/Users/<USER>Library/Application Support/Titanium/mobilesdk/osx/1.8.0.1/iphone/builder.py"""""""", line 1523, in <module>      main(sys.argv)    File """"""""/Users/<USER>Library/Application Support/Titanium/mobilesdk/osx/1.8.0.1/iphone/builder.py"""""""", line 661, in main      iphone_creator.create(iphone_dir,True)    File """"""""/Users/<USER>Library/Application Support/Titanium/mobilesdk/osx/1.8.0.1/iphone/iphone.py"""""""", line 46, in create      tiapp = TiAppXML(os.path.join(project_dir,'tiapp.xml'))    File """"""""/Users/<USER>Library/Application Support/Titanium/mobilesdk/osx/1.8.0.1/iphone/../tiapp.py"""""""", line 52, in __init__      data = codecs.open(self.file,'r','utf-8','replace')    File """"""""/System/Library/Frameworks/Python.framework/Versions/2.7/lib/python2.7/codecs.py"""""""", line 881, in open      file = __builtin__.open(filename, mode, buffering)  IOError: [Errno 2] No such file or directory: u'/Users/<USER>iconTestUniversal copy/build/iphone/tiapp.xml'    Steps to reproduce:  1) <USER>git repo: """"""""titanum_mobile_tests_internal""""""""  2) Import project """"""""feature test/Packaging/IconTestUniversal""""""""  3) Attempt to package for distribution (ad-hoc or distribution)    Result:  Packaging failure    Expected:  Packaging succeeds without error    Notes:  Occurs in 1.8.0.1 with the same Project.  Does not occur with default project created with Studio  Did not occur with KS sample imported into studio    Workaround:  Attempt to package again. The first attempt fixes the problem, and the second attempt succeeds.""""""",Bug,"Title: iOS: packaging - First attempt to package for distribution with some projects results in error
Description: """"Description: WHile testing packaging with our pre-created Studio projects, I noticed that the first attempt to package failed with an error. This occurred regardless of using """"""""project clean"""""""". The second attempt was successful and all further attempts. THis could be related to the test projects being put in the GIT repo with no """"""""build"""""""" folder. Studio error log: Traceback (most recent call last): File """"""""/Users/<USER>Library/Application Support/Titanium/mobilesdk/osx/1.8.0.1/iphone/builder.py"""""""", line 1523, in <module> main(sys.argv) File """"""""/Users/<USER>Library/Application Support/Titanium/mobilesdk/osx/1.8.0.1/iphone/builder.py"""""""", line 661, in main iphone_creator.create(iphone_dir,True) File """"""""/Users/<USER>Library/Application Support/Titanium/mobilesdk/osx/1.8.0.1/iphone/iphone.py"""""""", line 46, in create tiapp = TiAppXML(os.path.join(project_dir,'tiapp.xml')) File """"""""/Users/<USER>Library/Application Support/Titanium/mobilesdk/osx/1.8.0.1/iphone/../tiapp.py"""""""", line 52, in __init__ data = codecs.open(self.file,'r','utf-8','replace') File """"""""/System/Library/Frameworks/Python.framework/Versions/2.7/lib/python2.7/codecs.py"""""""", line 881, in open file = __builtin__.open(filename, mode, buffering) IOError: [Errno 2] No such file or directory: u'/Users/<USER>iconTestUniversal copy/build/iphone/tiapp.xml' Steps to reproduce: 1) <USER>git repo: """"""""titanum_mobile_tests_internal"""""""" 2) Import project """"""""feature test/Packaging/IconTestUniversal"""""""" 3) Attempt to package for distribution (ad-hoc or distribution) Result: Packaging failure Expected: Packaging succeeds without error Notes: Occurs in 1.8.0.1 with the same Project. Does not occur with default project created with Studio Did not occur with KS sample imported into studio Workaround: Attempt to package again. The first attempt fixes the problem, and the second attempt succeeds.""""",title+description
TIMOB-7479,12,"""iOS: KS - In Text Field > Keyboard test, a gap appears above the last row of numeric pads""","""""""Steps to reproduce:  1. Install KS from Samples pane  2. Go to Controls > Text Field > Keyboard  3. Press ASCII then press Phone Pad or Numbers Pad or Decimal Pad  4. Rotate device to landscape    Actual: A gap appears above the last row of the pad. See attachments.  Expected: Numeric pads should not contain a gap.    Note:  * This bug appears in 1.8.0.1  * Notice the change in pad appearance after step 3. Not sure if it's a bug or KS bug.""""""",Bug,"Title: iOS: KS - In Text Field > Keyboard test, a gap appears above the last row of numeric pads
Description: """"Steps to reproduce: 1. Install KS from Samples pane 2. Go to Controls > Text Field > Keyboard 3. Press ASCII then press Phone Pad or Numbers Pad or Decimal Pad 4. Rotate device to landscape Actual: A gap appears above the last row of the pad. See attachments. Expected: Numeric pads should not contain a gap. Note: * This bug appears in 1.8.0.1 * Notice the change in pad appearance after step 3. Not sure if it's a bug or KS bug.""""",title+description
