TIMOB-19623,12,"""iOS: label elements in the rows of a tableview disappear after using searchbar twice""","""""""h2. Problem description#  The label elements in the rows of a tableview disappear after using searchbar twice.    h2. Steps to reproduce  1. Start app  2. Tap the searchbar and enter """"""""row""""""""  3. Tap on the first row of the search result  4. Tab on the """"""""OK"""""""" button of the alert box  5. tab on the searchbar again    All label elements disappeared    h2. Test case  {code:lang=javascript|title=app.js}  (function() {   Ti.UI.backgroundColor = 'white';      var win, view, table, data, row, lbl, search, i, j;      win = Ti.UI.createWindow({backgroundColor:'#ffffff'});   view = Titanium.UI.createView({backgroundColor:""""""""#FFFEEE"""""""",top:0});   search = Titanium.UI.createSearchBar();      data  = [];   for(i=0,j=10; i<j; i++){     row = Ti.UI.createTableViewRow({color:'transparent',title:""""""""Test Row """"""""+i});     lbl = Ti.UI.createLabel({text:""""""""Test Row""""""""+i});       row.add(lbl);     data.push(row);   }       table = Ti.UI.createTableView({search:search,data:data});      table.addEventListener('click', function(evt){alert('clicked');});     view.add(table);   win.add(view);     var navWin1 = Titanium.UI.iOS.createNavigationWindow({window: win});   navWin1.open();  })();   {code}""""""",Bug,"Title: iOS: label elements in the rows of a tableview disappear after using searchbar twice
Description: """"h2. Problem description# The label elements in the rows of a tableview disappear after using searchbar twice. h2. Steps to reproduce 1. Start app 2. Tap the searchbar and enter """"""""row"""""""" 3. Tap on the first row of the search result 4. Tab on the """"""""OK"""""""" button of the alert box 5. tab on the searchbar again All label elements disappeared h2. Test case {code:lang=javascript|title=app.js} (function() { Ti.UI.backgroundColor = 'white'; var win, view, table, data, row, lbl, search, i, j; win = Ti.UI.createWindow({backgroundColor:'#ffffff'}); view = Titanium.UI.createView({backgroundColor:""""""""#FFFEEE"""""""",top:0}); search = Titanium.UI.createSearchBar(); data = []; for(i=0,j=10; i<j; i++){ row = Ti.UI.createTableViewRow({color:'transparent',title:""""""""Test Row """"""""+i}); lbl = Ti.UI.createLabel({text:""""""""Test Row""""""""+i}); row.add(lbl); data.push(row); } table = Ti.UI.createTableView({search:search,data:data}); table.addEventListener('click', function(evt){alert('clicked');}); view.add(table); win.add(view); var navWin1 = Titanium.UI.iOS.createNavigationWindow({window: win}); navWin1.open(); })(); {code}""""",title+description
TIMOB-19622,12,"""Facebook Messenger integration""","""""""Hello,  I'd like to ask if <USER>plans to integrate Facebook Messenger SDK to easily send messages via Messenger platform. It would be nice feature.  I found this official documentation: https://developers.facebook.com/docs/messenger/ios  Thank you.""""""",New Feature,"Title: Facebook Messenger integration
