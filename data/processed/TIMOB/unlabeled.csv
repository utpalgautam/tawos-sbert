8eb1bd 0x38eb0d6 0x3e9498 0x3f0b77 0x3f1338 0x3f36f6 0x2fef08 0x2fb3d8 0x2fd53f 0x343041 0x2a4328 0x47f5f 0x33cc705 0x4d421 0x4f8a8 0x4813d 0x49101 0x33cc6b0 0x5097b 0xe22805 0xe22764 0x9146d5b7 0x91457d4e)    -- End simulator log ---------------------------------------------------------    [ERROR] :  An error occurred running the iOS Simulator  [ERROR] :    [ERROR] :  Project failed to build after 16s 713ms  {quote}    """"""",Bug,"Title: Ti.Codec.encodeNumber crashes iOS Simulator when encoding numbers > 128 with breakpoints or stepping
