TIMOB-3265,12,"""iOS: textArea height and width 'auto'""","""""""{html}<div><h2>Problem</h2>  <p>When using a textArea, there is no way to make the field auto  expand to fit the text. The only option is that the text will  scroll. Label is able to produce the desired results. See test  code.</p>  <h2>Sample Code</h2>  <pre>  <code>var win = Titanium.UI.createWindow();    var textArea = Ti.UI.createTextArea({  width:200,  height:'40',  top:10,  value:'test'  });    var label = Ti.UI.createLabel({  backgroundColor:'#fff',  width:200,  height:'auto',  top:60,  text:textArea.value  });    win.add(textArea);  win.add(label);    textArea.addEventListener('change', function(e){  label.text=e.value;  });  win.open();</code>  </pre>  <h2>Related Documentation</h2>  <p>Ticket Reference: <a href=  """"""""http://developer.<USER>com/helpdesk/view/76226"""""""">http://developer.<USER>com/helpdesk/view/76226</a></p></div>{html}""""""",New Feature,"Title: iOS: textArea height and width 'auto'
Description: """"{html}<div><h2>Problem</h2> <p>When using a textArea, there is no way to make the field auto expand to fit the text. The only option is that the text will scroll. Label is able to produce the desired results. See test code.</p> <h2>Sample Code</h2> <pre> <code>var win = Titanium.UI.createWindow(); var textArea = Ti.UI.createTextArea({ width:200, height:'40', top:10, value:'test' }); var label = Ti.UI.createLabel({ backgroundColor:'#fff', width:200, height:'auto', top:60, text:textArea.value }); win.add(textArea); win.add(label); textArea.addEventListener('change', function(e){ label.text=e.value; }); win.open();</code> </pre> <h2>Related Documentation</h2> <p>Ticket Reference: <a href= """"""""http://developer.<USER>com/helpdesk/view/76226"""""""">http://developer.<USER>com/helpdesk/view/76226</a></p></div>{html}""""",title+description
