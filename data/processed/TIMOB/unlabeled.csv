Description: """"This is to make official the issue I reported by email in February. All of the SHA1 hashes listed on the [Continuous Builds|http://builds.<USER>com.s3.amazonaws.com/index.html] site are incorrect. See the following h3. On the builds site, 28 May 2011: h3. At the local terminal: """"",title+description
TIMOB-4238,12,"""aacp radio stream""","""""""I have tried to do live radio streaming in titanium <USER> But all the time Audio queue creation failed message will come in simulator. I have used below code. The radio stream is in aacp format. I have spent two days in this problem. but still stuck, no one give me any clue what should i do? Please help me if it is possible for you. Thanks in advance.    {code:lang=javascript}  var s = """"""""http://i1.al.iy.ast.com/na-live-64"""""""";    //audioFormat:AUDIO_FORMAT_AAC,    var sound = Ti.Media.createAudioPlayer({url:s,preload:true,allowBackground:true});    if(!sound.isMediaTypeSupported())  {    alert(""""""""No"""""""");  }    sound.format = Titanium.Media.AUDIO_FORMAT_AAC;  sound.addEventListener('error', function(e){      if(e.message == """"""""Unknown media error""""""""){        alert(""""""""No"""""""");      }  });    sound.addEventListener('complete', function(){      // your code here  });    sound.addEventListener('interrupted', function(){     // your code here  });    sound.addEventListener('resume', function(){     // your code here  });    sound.addEventListener('progress', function(e){     // your code here  });    sound.start();    {code}  """"""",Bug,"Title: aacp radio stream
