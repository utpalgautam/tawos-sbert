TIMOB-14340,12,"""iOS7: Localhost prefix from file:// path has been removed""","""""""I have successfully patched the iOS 7 file system with this fix:    {code:objc}  -(NSString*)pathFromComponents:(NSArray*)args  {  NSString * newpath;  id first = [args objectAtIndex:0];  if ([first hasPrefix:@""""""""file://""""""""])  {  NSURL * fileUrl = [NSURL URLWithString:first];  newpath =[fileUrl path];  }  {code}    function in the FilesystemModule.m file    iOS 7 has removed the localhost prefix from the file:// path.""""""",Bug,"Title: iOS7: Localhost prefix from file:// path has been removed
Description: """"I have successfully patched the iOS 7 file system with this fix: {code:objc} -(NSString*)pathFromComponents:(NSArray*)args { NSString * newpath; id first = [args objectAtIndex:0]; if ([first hasPrefix:@""""""""file://""""""""]) { NSURL * fileUrl = [NSURL URLWithString:first]; newpath =[fileUrl path]; } {code} function in the FilesystemModule.m file iOS 7 has removed the localhost prefix from the file:// path.""""",title+description
