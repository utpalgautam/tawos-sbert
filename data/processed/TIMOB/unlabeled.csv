TIMOB-15925,12,"""Android swipeup/swipedown event from button not fired on ScrollView""","""""""An application has a button on ScrollView, and this application want to get swipeup/swipedown event from button.  But on android, swipeup/swipedown event not fired.    below is sample code:    {code:JavaScript}  var window = Ti.UI.createWindow({fullscreen:false});    var view = Ti.UI.createScrollView({backgroundColor: 'green'});  window.add(view);    view.addEventListener('swipe', function(e){   alert('view' + e.direction);  });      var button = Ti.UI.createButton({   title: 'swipe it!',   width: '300px',   height: '300px'  });  view.add(button);    button.addEventListener('swipe', function(e){   alert('button' + e.direction);  });    window.open();    {code}""""""",Bug,"Title: Android swipeup/swipedown event from button not fired on ScrollView
Description: """"An application has a button on ScrollView, and this application want to get swipeup/swipedown event from button. But on android, swipeup/swipedown event not fired. below is sample code: {code:JavaScript} var window = Ti.UI.createWindow({fullscreen:false}); var view = Ti.UI.createScrollView({backgroundColor: 'green'}); window.add(view); view.addEventListener('swipe', function(e){ alert('view' + e.direction); }); var button = Ti.UI.createButton({ title: 'swipe it!', width: '300px', height: '300px' }); view.add(button); button.addEventListener('swipe', function(e){ alert('button' + e.direction); }); window.open(); {code}""""",title+description
