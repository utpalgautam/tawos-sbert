TIMOB-6760,12,"""Parity: Inconsistent XHR behavior handling 304 Not Modified status code on Android and iOS""","""""""h2.Problem  There seems to be an issue in XHR handling a 304 Not Modified status code on Android and iOS.     h6.On Android the XHR.onerror function is called but on iOS the XHR.onload function is called.    h6.Repro sequence  {code:title=app.js}  var url = """"""""http://localhost:8080/test"""""""";  Titanium.API.debug( """"""""Sending GET request to """""""" + url );    var xhr = Titanium.Network.createHTTPClient();    xhr.onload = function()  {      Titanium.API.debug( """"""""XHR onload()"""""""" );      Titanium.API.debug( xhr );      Titanium.API.debug( """"""""Response """""""" + xhr.status );      Titanium.API.debug( """"""""Response text """""""" + xhr.responseText )  };    xhr.onerror = function( e )  {      Titanium.API.debug( """"""""XHR error()"""""""" );      Titanium.API.debug( xhr );      Titanium.API.debug( """"""""Response """""""" + xhr.status );      Titanium.API.debug( """"""""Response text """""""" + xhr.responseText )      Titanium.API.debug( e );    };    xhr.open( """"""""GET"""""""", url );  xhr.send();  {code}      h2.iOS logs    h6.Here is the GET request and response for the 304 Not Modified status code on iOS:          h6.Here is the output from Titanium Studio on iOS:          h2.Android logs    h6.Here is the GET request and response for the 304 Not Modified status code on Android:        h6.Here is the output from Titanium Studio on Android:          h6.Titanium Studio also outputted the following stacktrace on Android:          h3.Additional info  The Apache HTTP Client exception in the Android stack trace caused for any NON 2XX status:    http://hc.apache.org/httpcomponents-client-ga/httpclient/apidocs/org/apache/http/client/HttpResponseException.html    2xx series are successful by Status Code Definitions, further reference here:     http://www.w3.org/Protocols/rfc2616/rfc2616-sec10.html      h6.Customer's remarks  """"""""Although Android is throwing the exception the real problem seems to be that on Android XHR.onerror is called when a 304 status code is returned but on iOS XHR.onload is called. Rather than having the same success logic in both methods we ended up reworking our solution to use a 200 OK response since both platforms handle that in the XHR.onload method. Because of the rework of this issue is no longer blocking us. I created the ticket in case other users were seeing similar behavior.""""""""      h6.Associated HD ticket  APP-163995""""""",Bug,"Title: Parity: Inconsistent XHR behavior handling 304 Not Modified status code on Android and iOS
Description: """"h2.Problem There seems to be an issue in XHR handling a 304 Not Modified status code on Android and iOS. h6.On Android the XHR.onerror function is called but on iOS the XHR.onload function is called. h6.Repro sequence {code:title=app.js} var url = """"""""http://localhost:8080/test""""""""; Titanium.API.debug( """"""""Sending GET request to """""""" + url ); var xhr = Titanium.Network.createHTTPClient(); xhr.onload = function() { Titanium.API.debug( """"""""XHR onload()"""""""" ); Titanium.API.debug( xhr ); Titanium.API.debug( """"""""Response """""""" + xhr.status ); Titanium.API.debug( """"""""Response text """""""" + xhr.responseText ) }; xhr.onerror = function( e ) { Titanium.API.debug( """"""""XHR error()"""""""" ); Titanium.API.debug( xhr ); Titanium.API.debug( """"""""Response """""""" + xhr.status ); Titanium.API.debug( """"""""Response text """""""" + xhr.responseText ) Titanium.API.debug( e ); }; xhr.open( """"""""GET"""""""", url ); xhr.send(); {code} h2.iOS logs h6.Here is the GET request and response for the 304 Not Modified status code on iOS: h6.Here is the output from Titanium Studio on iOS: h2.Android logs h6.Here is the GET request and response for the 304 Not Modified status code on Android: h6.Here is the output from Titanium Studio on Android: h6.Titanium Studio also outputted the following stacktrace on Android: h3.Additional info The Apache HTTP Client exception in the Android stack trace caused for any NON 2XX status: http://hc.apache.org/httpcomponents-client-ga/httpclient/apidocs/org/apache/http/client/HttpResponseException.html 2xx series are successful by Status Code Definitions, further reference here: http://www.w3.org/Protocols/rfc2616/rfc2616-sec10.html h6.Customer's remarks """"""""Although Android is throwing the exception the real problem seems to be that on Android XHR.onerror is called when a 304 status code is returned but on iOS XHR.onload is called. Rather than having the same success logic in both methods we ended up reworking our solution to use a 200 OK response since both platforms handle that in the XHR.onload method. Because of the rework of this issue is no longer blocking us. I created the ticket in case other users were seeing similar behavior."""""""" h6.Associated HD ticket APP-163995""""",title+description
