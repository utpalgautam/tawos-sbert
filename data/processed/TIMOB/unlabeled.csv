TIMOB-11651,12,"""BlackBerry: Implement removeAllChildren on Views""","""""""Implement the removeAllChildren on viewProxy. iOS and Android where implement through http://jira.<USER>org/browse/TC-1193. Test case is also in that ticket.     When updating documentation to show the new platform support, note that there are several exceptions to the existing support for removeAllChildren, as documented here: https://github.com/<USER>titanium_mobile/pull/3411/files    Some views (such as SearchBar) do not advertise support for add(), so they do not need to support removeAllChildren(). In other cases (such as Window), the exceptions are purely a result of the existing implementation. If the implementation on MW/BB differs from the implementation on Android/iOS, the appropriate docs should be updated as well. For example, removing removeAllChildren from the {{excludes:}} list, and adding a minimal definition to the {{methods:}} list, including the method name and platforms field (everything else can be inherited). i.e.:      """"""",New Feature,"Title: BlackBerry: Implement removeAllChildren on Views
Description: """"Implement the removeAllChildren on viewProxy. iOS and Android where implement through http://jira.<USER>org/browse/TC-1193. Test case is also in that ticket. When updating documentation to show the new platform support, note that there are several exceptions to the existing support for removeAllChildren, as documented here: https://github.com/<USER>titanium_mobile/pull/3411/files Some views (such as SearchBar) do not advertise support for add(), so they do not need to support removeAllChildren(). In other cases (such as Window), the exceptions are purely a result of the existing implementation. If the implementation on MW/BB differs from the implementation on Android/iOS, the appropriate docs should be updated as well. For example, removing removeAllChildren from the {{excludes:}} list, and adding a minimal definition to the {{methods:}} list, including the method name and platforms field (everything else can be inherited). i.e.: """"",title+description
TIMOB-11650,12,"""Android: Action bar is not showing icon along with text for the menu item in spite of space availability.""","""""""Not a regression. This is a new feature. Not visible with 2.1.4.     Steps to reproduce:  1. Use the code below in app.js  {code}  var win = Ti.UI.createWindow({fullscreen: false, backgroundColor: 'red'});     win.activity.onCreateOptionsMenu = function(e) {    var item = e.menu.add({title: 'expand',icon:'images/flower.jpg'});    item.showAsAction = Ti.Android.SHOW_AS_ACTION_WITH_TEXT;       var collapseActionButton = Ti.UI.createButton({      title: 'Collapse'    });    collapseActionButton.addEventListener('click', function() {      item.collapseActionView();    });    item.actionView = collapseActionButton;       item.on('expand', function() {      alert('Expanded menu item!');    });    item.on('collapse', function() {      alert('Collapsed menu item!');    });    item.on('click', function() {      alert('clicked!');    });  }     win.open();  {code}    2. Add the below code in tiapp.xml    {code:xml}  <android xmlns:android=""""""""http://schemas.android.com/apk/res/android"""""""">      <tool-api-level>11</tool-api-level>      <manifest>          <uses-sdk android:targetSdkVersion=""""""""11""""""""/>          <!-- other manifest entries -->      </manifest>  </android>  {code}    3. Run the app and click the action bar    Expected result  3. The action bar should display the menu item 'expand' along with an icon image.    Actual result:  3. The action bar only displays the title and not the icon.  Even on using 'item.showAsAction = Ti.Android.SHOW_AS_ACTION_IF_ROOM;' alone as well as along with 'Ti.Android.SHOW_AS_ACTION_WITH_TEXT;' , it do not shows icon even when enough space is available.""""""",Bug,"Title: Android: Action bar is not showing icon along with text for the menu item in spite of space availability.
Description: """"Not a regression. This is a new feature. Not visible with 2.1.4. Steps to reproduce: 1. Use the code below in app.js {code} var win = Ti.UI.createWindow({fullscreen: false, backgroundColor: 'red'}); win.activity.onCreateOptionsMenu = function(e) { var item = e.menu.add({title: 'expand',icon:'images/flower.jpg'}); item.showAsAction = Ti.Android.SHOW_AS_ACTION_WITH_TEXT; var collapseActionButton = Ti.UI.createButton({ title: 'Collapse' }); collapseActionButton.addEventListener('click', function() { item.collapseActionView(); }); item.actionView = collapseActionButton; item.on('expand', function() { alert('Expanded menu item!'); }); item.on('collapse', function() { alert('Collapsed menu item!'); }); item.on('click', function() { alert('clicked!'); }); } win.open(); {code} 2. Add the below code in tiapp.xml {code:xml} <android xmlns:android=""""""""http://schemas.android.com/apk/res/android""""""""> <tool-api-level>11</tool-api-level> <manifest> <uses-sdk android:targetSdkVersion=""""""""11""""""""/> <!-- other manifest entries --> </manifest> </android> {code} 3. Run the app and click the action bar Expected result 3. The action bar should display the menu item 'expand' along with an icon image. Actual result: 3. The action bar only displays the title and not the icon. Even on using 'item.showAsAction = Ti.Android.SHOW_AS_ACTION_IF_ROOM;' alone as well as along with 'Ti.Android.SHOW_AS_ACTION_WITH_TEXT;' , it do not shows icon even when enough space is available.""""",title+description
