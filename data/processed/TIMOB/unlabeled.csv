TIMOB-572,12,"""Ti.Platform.name crashes Android emulator""","""""""{html}<div><p>The following <strong>app.js</strong> causes Android emulator to crash in 1.0.0. Replacing <strong>Ti.Platform.name</strong> with a simple string prevents the crash.</p> <pre> <code class=""""""""javascript""""""""> var win1 = Titanium.UI.createWindow({       title:'Tab 1',     backgroundColor:'#fff' });  var label1 = Ti.UI.createLabel({     title: Ti.platform.name });  win1.add(label1); win1.open();</code> </pre></div>{html}""""""",Bug,"Title: Ti.Platform.name crashes Android emulator
Description: """"{html}<div><p>The following <strong>app.js</strong> causes Android emulator to crash in 1.0.0. Replacing <strong>Ti.Platform.name</strong> with a simple string prevents the crash.</p> <pre> <code class=""""""""javascript""""""""> var win1 = Titanium.UI.createWindow({ title:'Tab 1', backgroundColor:'#fff' }); var label1 = Ti.UI.createLabel({ title: Ti.platform.name }); win1.add(label1); win1.open();</code> </pre></div>{html}""""",title+description
TIMOB-571,12,"""tabBarHidden is ignored in Android""","""""""{html}<div><p>Version 1.0</p> <p>android emulator 1.6 with API's</p> <p>iPhone ok</p> <p>v simple code. one window, one tab....<br></p> <pre> <code>// create tab group var tabGroup = Titanium.UI.createTabGroup();<br> <br>   <br> // // create base UI tab and root window // var win1 = Titanium.UI.createWindow({<br> <br> <br>   </code> </pre> <pre> <code><code>url:'main_windows/login.js', titleImage:'images/<USER>small.png', tabBarHidden:true</code></code> </pre> <pre>   <br> });  <br> var tab1 = Titanium.UI.createTab({<br>   </pre> <pre> <code>icon:'images/tabs/KS_nav_views.png', title:'Base UI', window:win1</code> </pre> <pre>   <br> });  <br> tabGroup.addTab(tab1);<br>   <br> tabGroup.setActiveTab(1); // open tab group with a transition animation tabGroup.open({  </pre> <pre> <code>transition:Titanium.UI.iPhone.AnimationStyle.FLIP_FROM_LEFT</code> </pre> <pre>   <br> }); </pre> <p>main_windows/login.js creates a couple of text boxes and lables - its the same when all code is removed from main_windows/login.js.</p></div>{html}""""""",Bug,"Title: tabBarHidden is ignored in Android
Description: """"{html}<div><p>Version 1.0</p> <p>android emulator 1.6 with API's</p> <p>iPhone ok</p> <p>v simple code. one window, one tab....<br></p> <pre> <code>// create tab group var tabGroup = Titanium.UI.createTabGroup();<br> <br> <br> // // create base UI tab and root window // var win1 = Titanium.UI.createWindow({<br> <br> <br> </code> </pre> <pre> <code><code>url:'main_windows/login.js', titleImage:'images/<USER>small.png', tabBarHidden:true</code></code> </pre> <pre> <br> }); <br> var tab1 = Titanium.UI.createTab({<br> </pre> <pre> <code>icon:'images/tabs/KS_nav_views.png', title:'Base UI', window:win1</code> </pre> <pre> <br> }); <br> tabGroup.addTab(tab1);<br> <br> tabGroup.setActiveTab(1); // open tab group with a transition animation tabGroup.open({ </pre> <pre> <code>transition:Titanium.UI.iPhone.AnimationStyle.FLIP_FROM_LEFT</code> </pre> <pre> <br> }); </pre> <p>main_windows/login.js creates a couple of text boxes and lables - its the same when all code is removed from main_windows/login.js.</p></div>{html}""""",title+description
