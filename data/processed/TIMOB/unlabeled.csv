TIMOB-1038,12,"""video crash after 3 plays""","""""""{html}<div><p>app has multiple images. click image to play video. after 2-3 clicks - app crashes. code:</p> <pre> <code class=""""""""javascript""""""""> var win = Titanium.UI.createWindow();  var scrollView = Titanium.UI.createScrollView({     contentWidth:320,     contentHeight:'auto',     top:0,     showVerticalScrollIndicator:true,     showHorizontalScrollIndicator:false     });      var actInd = Titanium.UI.createActivityIndicator({     bottom:10,      height:50,     width:10,     style:Titanium.UI.iPhone.ActivityIndicatorStyle.BIG });  var xhr = Ti.Network.createHTTPClient();  xhr.open(""""""""GET"""""""",""""""""http://www.jimmyjohansson.net/rss/workIphoneRSS.xml"""""""");  xhr.onerror = function() { actInd.hide();    alert(""""""""Error: Please check you're data connection and restart the app.""""""""); };  actInd.show();  xhr.onload = function() {     try     {         var doc = this.responseXML.documentElement;         var items = doc.getElementsByTagName(""""""""item"""""""");         for (var c=0;c&lt;items.length;c++){             var item = items.item(c);                        var link = item.getElementsByTagName(""""""""link"""""""").item(0).text;             var image = item.getElementsByTagName(""""""""image"""""""").item(0).text;             var imageView = Titanium.UI.createImageView({                 url:image,                 id:link,                 defaultImage:'images/loading-small.png',                 top:127*c,                 width:320,                 height:127             });                          scrollView.add(imageView);                                                   }         win.add(scrollView);                      actInd.hide();     }     catch(E){         alert(E);     } };  xhr.send();  win.add(actInd);  scrollView.addEventListener('click',function(e){     var source = e.source;     var activeMovie = Titanium.Media.createVideoPlayer({         backgroundColor:'#000',         url:source.id,         movieControlMode:Titanium.Media.VIDEO_CONTROL_FULLSCREEN,         scalingMode:Titanium.Media.VIDEO_SCALING_MODE_FILL     });     activeMovie.play(); });  win.open();</code> </pre></div>{html}""""""",Bug,"Title: video crash after 3 plays
Description: """"{html}<div><p>app has multiple images. click image to play video. after 2-3 clicks - app crashes. code:</p> <pre> <code class=""""""""javascript""""""""> var win = Titanium.UI.createWindow(); var scrollView = Titanium.UI.createScrollView({ contentWidth:320, contentHeight:'auto', top:0, showVerticalScrollIndicator:true, showHorizontalScrollIndicator:false }); var actInd = Titanium.UI.createActivityIndicator({ bottom:10, height:50, width:10, style:Titanium.UI.iPhone.ActivityIndicatorStyle.BIG }); var xhr = Ti.Network.createHTTPClient(); xhr.open(""""""""GET"""""""",""""""""http://www.jimmyjohansson.net/rss/workIphoneRSS.xml""""""""); xhr.onerror = function() { actInd.hide(); alert(""""""""Error: Please check you're data connection and restart the app.""""""""); }; actInd.show(); xhr.onload = function() { try { var doc = this.responseXML.documentElement; var items = doc.getElementsByTagName(""""""""item""""""""); for (var c=0;c&lt;items.length;c++){ var item = items.item(c); var link = item.getElementsByTagName(""""""""link"""""""").item(0).text; var image = item.getElementsByTagName(""""""""image"""""""").item(0).text; var imageView = Titanium.UI.createImageView({ url:image, id:link, defaultImage:'images/loading-small.png', top:127*c, width:320, height:127 }); scrollView.add(imageView); } win.add(scrollView); actInd.hide(); } catch(E){ alert(E); } }; xhr.send(); win.add(actInd); scrollView.addEventListener('click',function(e){ var source = e.source; var activeMovie = Titanium.Media.createVideoPlayer({ backgroundColor:'#000', url:source.id, movieControlMode:Titanium.Media.VIDEO_CONTROL_FULLSCREEN, scalingMode:Titanium.Media.VIDEO_SCALING_MODE_FILL }); activeMovie.play(); }); win.open();</code> </pre></div>{html}""""",title+description
TIMOB-1037,12,"""Table search needs to preserve row layout""","""""""{html}<div><p>See Base UI -&gt; Table View -&gt; Layout 2 and conduct a search. Rows returned by the search are reconstituted from the search string, and are not the original row; HIG demands that we present the search results in a manner consistent with the original table.</p> <p>I guess this was a different bug and I accidentally closed it for the wrong reasons. Oops!</p></div>{html}""""""",Bug,"Title: Table search needs to preserve row layout
Description: """"{html}<div><p>See Base UI -&gt; Table View -&gt; Layout 2 and conduct a search. Rows returned by the search are reconstituted from the search string, and are not the original row; HIG demands that we present the search results in a manner consistent with the original table.</p> <p>I guess this was a different bug and I accidentally closed it for the wrong reasons. Oops!</p></div>{html}""""",title+description
TIMOB-1036,12,"""Android: WebView Exposes Ti Methods with Remote URL""","""""""{html}<div><p>This is a security issue. Titanium APIs should only be allowed for local urls</p></div>{html}""""""",Bug,"Title: Android: WebView Exposes Ti Methods with Remote URL
Description: """"{html}<div><p>This is a security issue. Titanium APIs should only be allowed for local urls</p></div>{html}""""",title+description
TIMOB-1035,12,"""Android: Properties API always expects default value""","""""""{html}<div><p>The current implementation always expects a default for each getXXXX() method instead of treating as a default. getXXXX() methods should acccept and Object[] and deal with the optional param correctly as documented in the API docs.</p></div>{html}""""""",Bug,"Title: Android: Properties API always expects default value
Description: """"{html}<div><p>The current implementation always expects a default for each getXXXX() method instead of treating as a default. getXXXX() methods should acccept and Object[] and deal with the optional param correctly as documented in the API docs.</p></div>{html}""""",title+description
TIMOB-1034,12,"""View in TableViewRow has wrong position""","""""""{html}<div><p>very simple example, just a row with a view inside.<br> when you use top:0 and bottom:0 the view is not inside the row even it has the same height as the row.<br> if you scroll up/down the position will be correct if the row becomes focus again.<br> if you remove top or bottom the postion is correct in the first call.</p> <p>tested with TD 1.2.1 &amp; iPhone SDK 3.1.3</p> <p>example code:</p> <p>var win = Ti.UI.currentWindow;<br> var tv = Titanium.UI.createTableView({<br> top:0,<br> data:[],<br> height:400,<br> minRowHeight:20,<br> backgroundColor:'#1b2839',<br> separatorStyle:Titanium.UI.iPhone.TableViewSeparatorStyle.NONE<br> });</p> <p>var row = Ti.UI.createTableViewRow({<br> backgroundColor:'#fff',<br> selectionStyle:'none',<br> height:40,<br> className: 'row'<br> });</p> <p>var view = Ti.UI.createView({<br> backgroundColor:'#3f6387',<br> left:10,<br> top:0,<br> bottom:0,<br> right:10,<br> height:40<br> });</p> <p>row.add(view);<br> var data = [];<br> data.push(row);<br> tv.setData(data);<br> win.add(tv);</p></div>{html}""""""",Bug,"Title: View in TableViewRow has wrong position
Description: """"{html}<div><p>very simple example, just a row with a view inside.<br> when you use top:0 and bottom:0 the view is not inside the row even it has the same height as the row.<br> if you scroll up/down the position will be correct if the row becomes focus again.<br> if you remove top or bottom the postion is correct in the first call.</p> <p>tested with TD 1.2.1 &amp; iPhone SDK 3.1.3</p> <p>example code:</p> <p>var win = Ti.UI.currentWindow;<br> var tv = Titanium.UI.createTableView({<br> top:0,<br> data:[],<br> height:400,<br> minRowHeight:20,<br> backgroundColor:'#1b2839',<br> separatorStyle:Titanium.UI.iPhone.TableViewSeparatorStyle.NONE<br> });</p> <p>var row = Ti.UI.createTableViewRow({<br> backgroundColor:'#fff',<br> selectionStyle:'none',<br> height:40,<br> className: 'row'<br> });</p> <p>var view = Ti.UI.createView({<br> backgroundColor:'#3f6387',<br> left:10,<br> top:0,<br> bottom:0,<br> right:10,<br> height:40<br> });</p> <p>row.add(view);<br> var data = [];<br> data.push(row);<br> tv.setData(data);<br> win.add(tv);</p></div>{html}""""",title+description
TIMOB-1033,12,"""Titanium 1.2.1 version""","""""""{html}<div><p>Hi! I think I found a bug in Titanium 1.2.1 version. I have wanted to change the font color of the navigation tab bar text, but I couldn't, till I updated the version to 1.3. Even if I updated the version, I wasn't able to see the change, but after I made a new project, and put the old code, has worked.</p> <p>BR, <USER>/p></div>{html}""""""",Bug,"Title: Titanium 1.2.1 version
Description: """"{html}<div><p>Hi! I think I found a bug in Titanium 1.2.1 version. I have wanted to change the font color of the navigation tab bar text, but I couldn't, till I updated the version to 1.3. Even if I updated the version, I wasn't able to see the change, but after I made a new project, and put the old code, has worked.</p> <p>BR, <USER>/p></div>{html}""""",title+description
TIMOB-1032,12,"""Android: Audio dies when switching between tabs""","""""""{html}<div><p>When switching between tabs on android the audio stops playing. Is there any way to keep this playing?</p> <p>Currently im using the below.</p> <p>var url = """"""""<a href= """"""""http://radiosonar.solent.ac.uk:8000/streamhi.mp3&quot;"""""""">http://radiosonar.solent.ac.uk:8000/streamhi.mp3""""""""</a>;<br> var streamer = Titanium.Media.createAudioPlayer({url:url,preload:true});</p></div>{html}""""""",Bug,"Title: Android: Audio dies when switching between tabs
Description: """"{html}<div><p>When switching between tabs on android the audio stops playing. Is there any way to keep this playing?</p> <p>Currently im using the below.</p> <p>var url = """"""""<a href= """"""""http://radiosonar.solent.ac.uk:8000/streamhi.mp3&quot;"""""""">http://radiosonar.solent.ac.uk:8000/streamhi.mp3""""""""</a>;<br> var streamer = Titanium.Media.createAudioPlayer({url:url,preload:true});</p></div>{html}""""",title+description
TIMOB-1031,12,"""provide selected type for camera (video or camera) when both options are available""","""""""{html}<div><p>see <a href= """"""""http://helpdesk.<USER>net/tickets/2729"""""""">http://helpdesk.<USER>net/tickets/2729</a></p> <p>need a property in the success event object - something like mediaType or selectedMediaType</p></div>{html}""""""",Bug,"Title: provide selected type for camera (video or camera) when both options are available
Description: """"{html}<div><p>see <a href= """"""""http://helpdesk.<USER>net/tickets/2729"""""""">http://helpdesk.<USER>net/tickets/2729</a></p> <p>need a property in the success event object - something like mediaType or selectedMediaType</p></div>{html}""""",title+description
TIMOB-1030,12,"""XHR requests""","""""""{html}<div><p>I have seen a couple instances now where when an application has many xhr requests the app crashes.</p> <p>See this ticket for reference..<br> <a href= """"""""http://helpdesk.<USER>net/tickets/2643"""""""">http://helpdesk.<USER>net/tickets/2643</a></p></div>{html}""""""",Bug,"Title: XHR requests
Description: """"{html}<div><p>I have seen a couple instances now where when an application has many xhr requests the app crashes.</p> <p>See this ticket for reference..<br> <a href= """"""""http://helpdesk.<USER>net/tickets/2643"""""""">http://helpdesk.<USER>net/tickets/2643</a></p></div>{html}""""",title+description
TIMOB-1029,12,"""Ability to instantly clear all rows from a tableview""","""""""{html}<div><p>I'm using a TableView to show a list of settings in my app, similar to Settings in the iPhone OS, and the easiest way to update the table after a setting has been changed is to re-add all the rows. The problem is, when I remove the rows using setData([]), it takes up half a second or so showing an unnecessary animation of all the rows being removed! When all I want is for the data to seamlessly be updated, that's an unacceptable user experience. It has to be really simple to get rid of that animation, but from my searching and experimenting so far it seems like it actually surprisingly might not be possible with the current state of the API (see <a href= """"""""http://developer.<USER>com/question/1271/how-to-set-data-to-a-table-view-without-animation""""""""> http://developer.<USER>com/question/1271/how-to-set-data-to-...</a> and the """"""""invalid"""""""" issue 815).</p> <p>Could this please be added ASAP?</p></div>{html}""""""",Bug,"Title: Ability to instantly clear all rows from a tableview
Description: """"{html}<div><p>I'm using a TableView to show a list of settings in my app, similar to Settings in the iPhone OS, and the easiest way to update the table after a setting has been changed is to re-add all the rows. The problem is, when I remove the rows using setData([]), it takes up half a second or so showing an unnecessary animation of all the rows being removed! When all I want is for the data to seamlessly be updated, that's an unacceptable user experience. It has to be really simple to get rid of that animation, but from my searching and experimenting so far it seems like it actually surprisingly might not be possible with the current state of the API (see <a href= """"""""http://developer.<USER>com/question/1271/how-to-set-data-to-a-table-view-without-animation""""""""> http://developer.<USER>com/question/1271/how-to-set-data-to-...</a> and the """"""""invalid"""""""" issue 815).</p> <p>Could this please be added ASAP?</p></div>{html}""""",title+description
TIMOB-1028,12,"""Android: Implement AudioRecorder""","""""""Android currently does not implement AudioRecorder.    We should look into implementing it using Android's [MediaRecorder|http://developer.android.com/reference/android/media/MediaRecorder.html].""""""",New Feature,"Title: Android: Implement AudioRecorder
Description: """"Android currently does not implement AudioRecorder. We should look into implementing it using Android's [MediaRecorder|http://developer.android.com/reference/android/media/MediaRecorder.html].""""",title+description
