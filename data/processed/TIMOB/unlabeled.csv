TIMOB-825,12,"""case insensitive search broken (using JS search function)""","""""""{html}<div><p>var mystring = """"""""Add to Address Book"""""""";</p> <p>// with /i modifier Ti.API.info(mystring.search(/s/i)); // -1 (incorrect) (string length: odd)<br> Ti.API.info(mystring.search(/ss/i)); // 12 (correct) (string length: even)<br> Ti.API.info(mystring.search(/ess/i)); // -1 (incorrect) (string length: odd)<br> Ti.API.info(mystring.search(/ress/i)); // 10 (correct) (string length: even)<br> Ti.API.info(mystring.search(/dress/i)); // -1 (incorrect) (string length: odd)<br> Ti.API.info(mystring.search(/ddress/i)); // 8 (correct) (string length: even)<br> Ti.API.info(mystring.search(/address/i)); // -1 (incorrect) (string length: odd)<br> Ti.API.info(mystring.search(/address /i)); // 7 (correct) (string length: even)</p> <p>// no modifier Ti.API.info(mystring.search(/address/)); // -1 (correct) (both cases correct here)<br> Ti.API.info(mystring.search(/ddress/)); // 8 (correct)</p> <p>in this code, any odd numbered search string fails. removing the /i (case insensitive) causes them all to work</p></div>{html}""""""",Bug,"Title: case insensitive search broken (using JS search function)
Description: """"{html}<div><p>var mystring = """"""""Add to Address Book"""""""";</p> <p>// with /i modifier Ti.API.info(mystring.search(/s/i)); // -1 (incorrect) (string length: odd)<br> Ti.API.info(mystring.search(/ss/i)); // 12 (correct) (string length: even)<br> Ti.API.info(mystring.search(/ess/i)); // -1 (incorrect) (string length: odd)<br> Ti.API.info(mystring.search(/ress/i)); // 10 (correct) (string length: even)<br> Ti.API.info(mystring.search(/dress/i)); // -1 (incorrect) (string length: odd)<br> Ti.API.info(mystring.search(/ddress/i)); // 8 (correct) (string length: even)<br> Ti.API.info(mystring.search(/address/i)); // -1 (incorrect) (string length: odd)<br> Ti.API.info(mystring.search(/address /i)); // 7 (correct) (string length: even)</p> <p>// no modifier Ti.API.info(mystring.search(/address/)); // -1 (correct) (both cases correct here)<br> Ti.API.info(mystring.search(/ddress/)); // 8 (correct)</p> <p>in this code, any odd numbered search string fails. removing the /i (case insensitive) causes them all to work</p></div>{html}""""",title+description
TIMOB-824,12,"""Parent events fired when child view has same event callback""","""""""{html}<div><p>Sample code:</p> <pre> <code>var w = Ti.UI.createWindow();  var v1 = Ti.UI.createView({     top:10,     left:10,     right:10,     bottom:10,     backgroundColor:'#ff0000' });  v1.addEventListener('touchstart', function() {     Ti.API.info('Touched view 1'); });  var v2 = Ti.UI.createView({     top:50,     left:50,     right:50,     bottom:50,     backgroundColor:'#00ff00' });  v2.addEventListener('touchstart', function() {     Ti.API.info('Touched view 2'); });  v1.add(v2); w.add(v1);  w.open();</code> </pre> <p>Click in the second view and you'll see both the events for v1 and v2 are fired. This may cause problems in some situations; maybe add a 'propagatesEvents' flag?</p></div>{html}""""""",Bug,"Title: Parent events fired when child view has same event callback
Description: """"{html}<div><p>Sample code:</p> <pre> <code>var w = Ti.UI.createWindow(); var v1 = Ti.UI.createView({ top:10, left:10, right:10, bottom:10, backgroundColor:'#ff0000' }); v1.addEventListener('touchstart', function() { Ti.API.info('Touched view 1'); }); var v2 = Ti.UI.createView({ top:50, left:50, right:50, bottom:50, backgroundColor:'#00ff00' }); v2.addEventListener('touchstart', function() { Ti.API.info('Touched view 2'); }); v1.add(v2); w.add(v1); w.open();</code> </pre> <p>Click in the second view and you'll see both the events for v1 and v2 are fired. This may cause problems in some situations; maybe add a 'propagatesEvents' flag?</p></div>{html}""""",title+description
TIMOB-823,12,"""table view rows with height auto don't render properly (intermittently)""","""""""{html}<div><p><a href=  """"""""http://helpdesk.<USER>net/tickets/2057"""""""">http://helpdesk.<USER>net/tickets/2057</a></p>  <p>source is attached to ticket. Click on splash screen, then click  on """"""""What's happening"""""""" box, the toggle table view by clicking  buttons at the top. some of the rows do not paint correctly.</p></div>{html}""""""",Bug,"Title: table view rows with height auto don't render properly (intermittently)
Description: """"{html}<div><p><a href= """"""""http://helpdesk.<USER>net/tickets/2057"""""""">http://helpdesk.<USER>net/tickets/2057</a></p> <p>source is attached to ticket. Click on splash screen, then click on """"""""What's happening"""""""" box, the toggle table view by clicking buttons at the top. some of the rows do not paint correctly.</p></div>{html}""""",title+description
TIMOB-822,12,"""movie crash on ipad using fullscreen""","""""""{html}<div><p>here's the code:</p> <p>1) if fullscreen is set after win.open the app crashes<br> 2) if you hit the fullscreen button on the video, the app crashes</p> <p>var win = Titanium.UI.createWindow({ backgroundColor:'#fff' });<br> var mymovie = Ti.Media.createVideoPlayer({<br> contentURL: '<a href= """"""""http://www.txstate.edu/prospectiveflash/VIDEO/Rising_Stars/ChristinaConlee.m4v'"""""""">http://www.txstate.edu/prospectiveflash/VIDEO/Rising_Stars/Christin...</a>,<br> backgroundColor:'#111',<br> movieControlMode:Ti.Media.VIDEO_CONTROL_FULLSCREEN,<br> scalingMode:Ti.Media.VIDEO_SCALING_ASPECT_FIT<br> });</p> <p>mymovie.addEventListener('fullscreen', function(e) {<br> Ti.API.info('nothing special in here');<br> }); win.add(mymovie);<br> mymovie.play();</p> <p>win.open();</p> <p>mymovie.fullscreen = true;</p></div>{html}""""""",Bug,"Title: movie crash on ipad using fullscreen
Description: """"{html}<div><p>here's the code:</p> <p>1) if fullscreen is set after win.open the app crashes<br> 2) if you hit the fullscreen button on the video, the app crashes</p> <p>var win = Titanium.UI.createWindow({ backgroundColor:'#fff' });<br> var mymovie = Ti.Media.createVideoPlayer({<br> contentURL: '<a href= """"""""http://www.txstate.edu/prospectiveflash/VIDEO/Rising_Stars/ChristinaConlee.m4v'"""""""">http://www.txstate.edu/prospectiveflash/VIDEO/Rising_Stars/Christin...</a>,<br> backgroundColor:'#111',<br> movieControlMode:Ti.Media.VIDEO_CONTROL_FULLSCREEN,<br> scalingMode:Ti.Media.VIDEO_SCALING_ASPECT_FIT<br> });</p> <p>mymovie.addEventListener('fullscreen', function(e) {<br> Ti.API.info('nothing special in here');<br> }); win.add(mymovie);<br> mymovie.play();</p> <p>win.open();</p> <p>mymovie.fullscreen = true;</p></div>{html}""""",title+description
TIMOB-821,12,"""Port EmailDialog to Android""","""""""{html}<div><p>cf <a href= """"""""http://github.com/<USER>titanium_mobile/commit/c7aa98b5dc9b7940c934c09795925e017bd983a7""""""""> http://github.com/<USER>titanium_mobile/commit/c7aa98b5dc9b7...</a><br> and <a href=""""""""/projects/32238/tickets/67"""""""" title= """"""""Ticket #67"""""""">#67</a></p></div>{html}""""""",Bug,"Title: Port EmailDialog to Android
