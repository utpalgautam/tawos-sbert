TIMOB-4417,12,"""Add pathing to assets for Javascript Modules""","""""""Resources placed in the assets directory when building a module get placed in /modules/[ti.module]/ of the application bundle, but when building a javascript module there seems to be no way to access those resources.  A sample module with a sample app is attached for testing.  This feature may also be related to this ticket: TIMOB-4233""""""",New Feature,"Title: Add pathing to assets for Javascript Modules
Description: """"Resources placed in the assets directory when building a module get placed in /modules/[ti.module]/ of the application bundle, but when building a javascript module there seems to be no way to access those resources. A sample module with a sample app is attached for testing. This feature may also be related to this ticket: TIMOB-4233""""",title+description
TIMOB-4416,12,"""iOS: Closing a Nav Group Interprets Window's JS Again""","""""""h1. Problem  Closing a nav group causes the open window's JavaScript to be interpreted and run again, as if it were being opened for the first time.    h2. Reproduction  Drop the following in an app.js win1.js and win2.js, respectively.  - When you run it, """"""""win1"""""""" (a nav group) will be opened  - You'll see an alert (""""""""Win 1 Opened!"""""""").  - After 1 second, win1 will be closed and win2 will be opened.  - You'll see an alert (""""""""Win 2 Opened!"""""""") followed by another (""""""""Win 1 Opened!"""""""").  {code:title=app.js}  var win1 = Ti.UI.createWindow();  win1.add(Titanium.UI.iPhone.createNavigationGroup({      window: Titanium.UI.createWindow({          navBarHidden: true,          backgroundColor: '#f00',          url: 'win1.js'      })  }));    var win2 = Titanium.UI.createWindow({      backgroundColor: '#0f0',      url: 'win2.js'  });    win1.open();    setTimeout(function() {      win2.open({transition:Titanium.UI.iPhone.AnimationStyle.FLIP_FROM_LEFT});      win1.close();  }, 1000);    {code:title=win2.js}  alert('Win 2 Opened!');  {code}    h2. Workaround  This isn't really a workaround, but if you do not close the nav group, this bug won't show up. Hide it instead (call win1.hide() instead of win1.close() and the bug will go away).    h3. Associated Helpdesk Ticket  http://appc.me/c/APP-422396""""""",Bug,"Title: iOS: Closing a Nav Group Interprets Window's JS Again
Description: """"h1. Problem Closing a nav group causes the open window's JavaScript to be interpreted and run again, as if it were being opened for the first time. h2. Reproduction Drop the following in an app.js win1.js and win2.js, respectively. - When you run it, """"""""win1"""""""" (a nav group) will be opened - You'll see an alert (""""""""Win 1 Opened!""""""""). - After 1 second, win1 will be closed and win2 will be opened. - You'll see an alert (""""""""Win 2 Opened!"""""""") followed by another (""""""""Win 1 Opened!""""""""). {code:title=app.js} var win1 = Ti.UI.createWindow(); win1.add(Titanium.UI.iPhone.createNavigationGroup({ window: Titanium.UI.createWindow({ navBarHidden: true, backgroundColor: '#f00', url: 'win1.js' }) })); var win2 = Titanium.UI.createWindow({ backgroundColor: '#0f0', url: 'win2.js' }); win1.open(); setTimeout(function() { win2.open({transition:Titanium.UI.iPhone.AnimationStyle.FLIP_FROM_LEFT}); win1.close(); }, 1000); {code:title=win2.js} alert('Win 2 Opened!'); {code} h2. Workaround This isn't really a workaround, but if you do not close the nav group, this bug won't show up. Hide it instead (call win1.hide() instead of win1.close() and the bug will go away). h3. Associated Helpdesk Ticket http://appc.me/c/APP-422396""""",title+description
TIMOB-4415,12,"""iOS: TableView Multiple appendRow Ignored""","""""""h1. Problem  If you create a table view and immediately call appendRow multiple times, only the last call to appendRow will do anything. So if you add 3 rows, only the 3rd will end up in the table.    h2. Reproduction  Drop the following in an app.js and run it; if this bug is present, you will only see 1 row. Otherwise, you will see 3.  {code:title=app.js}  var win = Ti.UI.createWindow({ backgroundColor: '#fff' });  win.open();    var table = Ti.UI.createTableView();    table.appendRow({ title: 'Row 1' });  table.appendRow({ title: 'Row 2' });  table.appendRow({ title: 'Row 3' });    win.add(table);      h3. Associated Helpdesk Ticket  http://appc.me/c/APP-281379""""""",Bug,"Title: iOS: TableView Multiple appendRow Ignored
Description: """"h1. Problem If you create a table view and immediately call appendRow multiple times, only the last call to appendRow will do anything. So if you add 3 rows, only the 3rd will end up in the table. h2. Reproduction Drop the following in an app.js and run it; if this bug is present, you will only see 1 row. Otherwise, you will see 3. {code:title=app.js} var win = Ti.UI.createWindow({ backgroundColor: '#fff' }); win.open(); var table = Ti.UI.createTableView(); table.appendRow({ title: 'Row 1' }); table.appendRow({ title: 'Row 2' }); table.appendRow({ title: 'Row 3' }); win.add(table); h3. Associated Helpdesk Ticket http://appc.me/c/APP-281379""""",title+description
TIMOB-4414,12,"""Property 'top' of the tableViewRow works incorrect in Android and ignored in iPhone""","""""""Property 'top' of the tableViewRow does not works on iOS. On Android the value of 'top' property attached to the inner content of the tableViewRow but the tableViewRow is still in the same position in the tableView.  Android:   !http://i52.tinypic.com/6fmb6g.png!  {code:JavaScript}  var win = Ti.UI.currentWindow;  win.backgroundColor = '#EEE';    var data = [{title:'This is row #1',color:'black',fontStyle: 'italic'},     {title:'This is row #2',color:'black',fontSize:15, top:30},     {title:'This is row #3',color:'black'},     {title:'This is row #4',color:'black'},     {title:'This is row #5',color:'black'}];    var tableView = Ti.UI.createTableView({   width: 300,   height: 200,   top: 70,   left: 10,   backgroundColor: '#AAA',   data:data  });    var closeButton = Ti.UI.createButton({   title:'Close Window',   height:50,   width:140,   fontSize: 16,   top:10,   left:90  });    closeButton.addEventListener('click', function(){   Titanium.UI.currentWindow.close();  });    win.add(closeButton);  win.add(tableView);  {code}""""""",Bug,"Title: Property 'top' of the tableViewRow works incorrect in Android and ignored in iPhone
Description: """"Property 'top' of the tableViewRow does not works on iOS. On Android the value of 'top' property attached to the inner content of the tableViewRow but the tableViewRow is still in the same position in the tableView. Android: !http://i52.tinypic.com/6fmb6g.png! {code:JavaScript} var win = Ti.UI.currentWindow; win.backgroundColor = '#EEE'; var data = [{title:'This is row #1',color:'black',fontStyle: 'italic'}, {title:'This is row #2',color:'black',fontSize:15, top:30}, {title:'This is row #3',color:'black'}, {title:'This is row #4',color:'black'}, {title:'This is row #5',color:'black'}]; var tableView = Ti.UI.createTableView({ width: 300, height: 200, top: 70, left: 10, backgroundColor: '#AAA', data:data }); var closeButton = Ti.UI.createButton({ title:'Close Window', height:50, width:140, fontSize: 16, top:10, left:90 }); closeButton.addEventListener('click', function(){ Titanium.UI.currentWindow.close(); }); win.add(closeButton); win.add(tableView); {code}""""",title+description
