video.Media'); var Participant = require('com.twilio.video.Participant'); var Room = require('com.twilio.video.Room'); var VideoClient = require('com.twilio.video.VideoClient'); var VideoTrack = require('com.twilio.video.VideoTrack'); var VideoView = require('com.twilio.video.VideoView'); var Activity = require('android.app.Activity'); var activity = new Activity(Ti.Android.currentActivity); var TWILIO_ACCESS_TOKEN = """"""""TWILIO_ACCESS_TOKEN""""""""; var TWILIO_LINK = """"""""https://twilio.medsymphony.com/test/video?username=milonandroid""""""""; var accessToken = """"""""""""""""; var primaryVideoView = new VideoView(activity); var thumbnailVideoView = new VideoView(activity); var audioManager = new AudioManager(activity); var participantIdentity = """"""""""""""""; var previousAudioMode = 0; var localVideoView = new VideoRenderer(activity); var disconnectedFromOnDestroy = false; var room; var cameraCapturer; var localMedia; // localMedia = new LocalMedia(); var localAudioTrack; var localVideoTrack; $.container.add(primaryVideoView); $.container.add(thumbnailVideoView); createLocalMedia(); $.container.addEventListener('open', function() { requestPermissionForCameraAndMicrophone(); }); $.container.open(); function createLocalMedia() { localMedia = new LocalMedia.create(activity); Ti.API.info('localMedia' + JSON.stringify(localMedia)); // Share your microphone localAudioTrack = localMedia.addAudioTrack(true); // Share your camera cameraCapturer = new CameraCapturer(activity, CameraSource.FRONT_CAMERA); localVideoTrack = localMedia.addVideoTrack(true, cameraCapturer); primaryVideoView.setMirror(true); localVideoTrack.addRenderer(primaryVideoView); localVideoView = primaryVideoView; }; })(arguments[0] || {}); var requestPermissionForCameraAndMicrophone = function() { var permissions = []; permissions.push('android.permission.CAMERA'); permissions.push('android.permission.RECORD_AUDIO'); Ti.Android.requestPermissions(permissions, function(e) { Ti.API.info('eee' + JS