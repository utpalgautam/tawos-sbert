cd ~/tawos-sbert
source .venv/bin/activate

cat > .gitignore <<'EOF'
# Python environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter
.ipynb_checkpoints/

# Environment variables and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Raw and generated data
data/raw/*
data/processed/*
data/embeddings/*
data/splits/*

# Preserve directory placeholders
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/embeddings/.gitkeep
!data/splits/.gitkeep

# Experiment logs: retain only the final experiment's logs
logs/*
!logs/.gitkeep
!logs/cnn/
logs/cnn/*
!logs/cnn/training_run.log
!logs/cnn/cv_training_history.csv
!logs/cnn/final_training_history.csv

# Temporary files
*.tmp
*.bak
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# Editor configuration
.idea/
.vscode/
EOF